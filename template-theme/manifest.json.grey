{
  // The accent recommended for user_color and user_color2 is #7C4DFF.
  // Accents are NOT set in this manifest (chrome resets accent prefs when a
  // theme is applied). Apply with: cobalt seed '#7C4DFF' --profile Default
  // (chrome's manifest parser allows comments; strict JSON parsers do not.)
  "name": "cobalt-theme",
  "version": "1.0",
  "description": "Cobalt theme.",
  "manifest_version": 3,
  "theme": {
    "colors": {
      // elevation ramp: 27 -> 40 -> 53, even 13-step increments.
      // ntp_background is pinned to #353535 to match the extension's
      // blank.html new tab page.
      "frame": [27, 27, 27],
      "frame_inactive": [23, 23, 23],
      "background_tab": [22, 22, 22],
      "background_tab_inactive": [19, 19, 19],
      "background_tab_hover": [34, 34, 34],
      "toolbar": [40, 40, 40],
      "toolbar_hover": [47, 47, 47],
      "toolbar_button_icon": [216, 216, 216],
      "toolbar_separator": [48, 48, 48],
      "tab_text": [235, 235, 235],
      "tab_background_text": [150, 150, 150],
      "bookmark_text": [216, 216, 216],
      "button_background": [34, 34, 34],
      "ntp_background": [53, 53, 53],
      "ntp_text": [216, 216, 216]
    }
  }
}
