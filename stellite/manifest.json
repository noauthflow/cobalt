{
  "name": "cobalt",
  "version": "1.3",
  "description": "Blank new tab page. De-annoys youtube.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "manifest_version": 3,
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["*://*/*"],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "popblock-rules",
      "enabled": true,
      "path": "popblock/rules.json"
    }]
  },
  "background": { "service_worker": "pin.js" },
  "commands": {
    "pin-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Pin or unpin the current tab"
    }
  },
  "chrome_url_overrides": { "newtab": "blank.html" },
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "css": ["hide.css"],
    "js": ["block.js"],
    "run_at": "document_start"
  }, {
    "matches": ["*://*.youtube.com/*"],
    "css": ["ytads/hide.css"],
    "js": ["ytads/ads.js"],
    "run_at": "document_start"
  }, {
    "matches": ["*://*/*"],
    "exclude_matches": ["*://*.youtube.com/*", "*://*.google.com/*"],
    "js": ["popblock/pop.js"],
    "run_at": "document_start",
    "all_frames": true,
    "world": "MAIN"
  }]
}
