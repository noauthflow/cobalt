# Chrome extension allowlist, read by apply-policy.sh on Linux and macOS.
# Everything not listed here is blocked.
#
# Plain KEY=VALUE lines. Not executed by a shell; `~` and `$HOME` expand.

# --- Web Store extensions -------------------------------------------------
# The ID comes from the extension's signing key, so it is identical on every
# OS. Every variable starting with WEBSTORE_ is an allowed ID.
WEBSTORE_1PASSWORD=aeblfdkhhhdcdjpifhhbdiojplfjncoa

# allowed          you may install them (Web Store "Add to Chrome")
# force_installed  Chrome installs them automatically and you cannot
#                  remove or disable them
WEBSTORE_MODE=allowed

# --- Unpacked extensions ("Load unpacked") --------------------------------
# Colon-separated directories, per OS. Chrome derives the ID from the
# absolute path (unless manifest.json has a "key"), so the IDs differ per
# machine and change if a folder is moved or renamed. Re-run
# apply-policy.sh after editing or moving anything.
UNPACKED_LINUX=~/dev/cobalt/stellite:~/dev/cobalt/stellite/template-theme:~/dev/uBOLite/
UNPACKED_MACOS=~/dev/uBlock:~/dev/cobalt/stellite:~/dev/cobalt/stellite/template-theme
