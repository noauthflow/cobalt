def build_dbus_objects(bus, state, verifier):
    import dbus
    import dbus.service

    def guard(sender, who):
        if not verifier.is_chrome(sender):
            state.denied += 1
            state.last_denied = {"sender": str(sender), "at": time.time(), "where": who}
            raise dbus.exceptions.DBusException(
                "caller is not verified Chrome",
                name="org.freedesktop.DBus.Error.AccessDenied")

    def deny_portal(msg):
        # Make portal refusals loud: a refused RetrieveSecret silently pushes
        # Chrome to v10 cookies.
        print(f"{APP}: portal call refused: {msg}", flush=True)
        state.denied += 1
        state.last_denied = {"sender": "portal", "at": time.time(),
                             "where": f"RetrieveSecret: {msg}"}
        raise dbus.exceptions.DBusException(
            msg, name="org.freedesktop.DBus.Error.AccessDenied")

    def portal_result(code):
        return (dbus.UInt32(code), dbus.Dictionary({}, signature="sv"))

    def guard_portal(sender):
        # The portal frontend is the only thing allowed to call the Secret
        # backend interface. Verify that it owns the portal name and that
        # the process lives in the xdg-desktop-portal.service cgroup.
        if not sender:
            deny_portal("no sender")
        try:
            owner = verifier._connection().call_blocking(
                "org.freedesktop.DBus", "/org/freedesktop/DBus",
                "org.freedesktop.DBus", "GetNameOwner", "s",
                ("org.freedesktop.portal.Desktop",))
            owner = str(owner)
        except Exception:
            deny_portal("portal is not running")
        if owner != str(sender):
            deny_portal("caller is not the portal")

        pid = verifier._pid_for_sender(sender)
        if pid is None:
            deny_portal("cannot resolve portal pid")
        try:
            with open(f"/proc/{pid}/cgroup") as f:
                cgroups = [line.rstrip("\n").split(":", 2)[-1] for line in f]
        except OSError as e:
            deny_portal(f"cannot read portal cgroup: {e}")
        if not any(cg.endswith("/" + PORTAL_UNIT) for cg in cgroups):
            deny_portal(f"portal not in {PORTAL_UNIT}: {cgroups!r}")
        try:
            exe = os.readlink(f"/proc/{pid}/exe")
        except OSError as e:
            deny_portal(f"cannot read portal exe: {e}")
        if exe not in PORTAL_BINARIES:
            deny_portal(f"unexpected portal binary {exe!r}")
        why = trusted_path(exe)
        if why:
            deny_portal(f"untrusted portal binary: {why}")

    class SecretService(dbus.service.Object):
        @dbus.service.method(IF_SERVICE, in_signature="s", out_signature="o",
                             sender_keyword="sender")
        def ReadAlias(self, name, sender=None):
            guard(sender, "ReadAlias")
            return dbus.ObjectPath(COLLECTION_PATH)

        @dbus.service.method(IF_SERVICE, in_signature="sv", out_signature="vo",
                             sender_keyword="sender")
        def OpenSession(self, _algorithm, _input, sender=None):
            guard(sender, "OpenSession")
            print(f"{APP}: refusing secret-service session", flush=True)
            raise dbus.exceptions.DBusException(
                "use the desktop portal",
                name="org.freedesktop.DBus.Error.NotSupported")

        @dbus.service.method(IF_SERVICE, in_signature="ao", out_signature="aoo",
                             sender_keyword="sender")
        def Unlock(self, objects, sender=None):
            guard(sender, "Unlock")
            return (objects, dbus.ObjectPath("/"))

        @dbus.service.method(IF_SERVICE, in_signature="ao", out_signature="aoo",
                             sender_keyword="sender")
        def Lock(self, objects, sender=None):
            guard(sender, "Lock")
            return (objects, dbus.ObjectPath("/"))

        @dbus.service.method(IF_SERVICE, in_signature="a{ss}", out_signature="aoo",
                             sender_keyword="sender")
        def SearchItems(self, attributes, sender=None):
            guard(sender, "SearchItems(service)")
            return ([dbus.ObjectPath(ITEM_PATH)], [])

        @dbus.service.method(IF_SERVICE, in_signature="a{sv}s", out_signature="oo",
                             sender_keyword="sender")
        def CreateCollection(self, properties, alias, sender=None):
            guard(sender, "CreateCollection")
            return (dbus.ObjectPath(COLLECTION_PATH), dbus.ObjectPath("/"))

    class Collection(dbus.service.Object):
        @dbus.service.method(IF_COLLECTION, in_signature="a{ss}", out_signature="aoo",
                             sender_keyword="sender")
        def SearchItems(self, attributes, sender=None):
            guard(sender, "SearchItems")
            return ([dbus.ObjectPath(ITEM_PATH)], [])

        @dbus.service.method(IF_COLLECTION, in_signature="a{sv}(oayays)b",
                             out_signature="oo", sender_keyword="sender")
        def CreateItem(self, properties, secret, replace, sender=None):
            guard(sender, "CreateItem")
            return (dbus.ObjectPath(ITEM_PATH), dbus.ObjectPath("/"))

        @dbus.service.method(IF_COLLECTION, in_signature="o", out_signature="o",
                             sender_keyword="sender")
        def Delete(self, item, sender=None):
            guard(sender, "Delete(collection)")
            return dbus.ObjectPath("/")

        @dbus.service.method(IF_PROPS, in_signature="ss", out_signature="v",
                             sender_keyword="sender")
        def Get(self, interface, prop, sender=None):
            guard(sender, "Collection.Get")
            if prop == "Label":
                return dbus.String("Default Keyring")
            if prop == "Items":
                return dbus.Array([dbus.ObjectPath(ITEM_PATH)], signature="o")
            if prop == "Locked":
                return dbus.Boolean(False)
            if prop == "Created":
                return dbus.UInt64(0)
            if prop == "Modified":
                return dbus.UInt64(int(time.time()))
            raise dbus.exceptions.DBusException(
                f"no such property {prop}", name="org.freedesktop.DBus.Error.InvalidArgs")

        @dbus.service.method(IF_PROPS, in_signature="s", out_signature="a{sv}",
                             sender_keyword="sender")
        def GetAll(self, interface, sender=None):
            guard(sender, "Collection.GetAll")
            return {
                "Label": dbus.String("Default Keyring"),
                "Items": dbus.Array([dbus.ObjectPath(ITEM_PATH)], signature="o"),
                "Locked": dbus.Boolean(False),
                "Created": dbus.UInt64(0),
                "Modified": dbus.UInt64(int(time.time())),
            }

        @dbus.service.method(IF_PROPS, in_signature="ssv", out_signature="",
                             sender_keyword="sender")
        def Set(self, interface, prop, value, sender=None):
            guard(sender, "Collection.Set")

    class Item(dbus.service.Object):
        @dbus.service.method(IF_ITEM, in_signature="(oayays)", out_signature="",
                             sender_keyword="sender")
        def SetSecret(self, _secret, sender=None):
            guard(sender, "SetSecret")

        @dbus.service.method(IF_ITEM, in_signature="", out_signature="o",
                             sender_keyword="sender")
        def Delete(self, sender=None):
            guard(sender, "Delete(item)")
            return dbus.ObjectPath("/")

        @dbus.service.method(IF_PROPS, in_signature="ss", out_signature="v",
                             sender_keyword="sender")
        def Get(self, interface, prop, sender=None):
            guard(sender, "Item.Get")
            attrs = {
                "application": "chrome",
                "xdg:schema": "chrome_libsecret_os_crypt_password_v2",
            }
            if prop == "Label":
                return dbus.String("Chrome Safe Storage")
            if prop == "Attributes":
                return dbus.Dictionary(attrs, signature="ss")
            if prop == "Locked":
                return dbus.Boolean(state.locked)
            if prop == "Created":
                return dbus.UInt64(0)
            if prop == "Modified":
                return dbus.UInt64(int(time.time()))
            raise dbus.exceptions.DBusException(
                f"no such property {prop}", name="org.freedesktop.DBus.Error.InvalidArgs")

        @dbus.service.method(IF_PROPS, in_signature="s", out_signature="a{sv}",
                             sender_keyword="sender")
        def GetAll(self, interface, sender=None):
            guard(sender, "Item.GetAll")
            return {
                "Label": dbus.String("Chrome Safe Storage"),
                "Attributes": dbus.Dictionary(
                    {"application": "chrome",
                     "xdg:schema": "chrome_libsecret_os_crypt_password_v2"},
                    signature="ss"),
                "Locked": dbus.Boolean(state.locked),
                "Created": dbus.UInt64(0),
                "Modified": dbus.UInt64(int(time.time())),
            }

        @dbus.service.method(IF_PROPS, in_signature="ssv", out_signature="",
                             sender_keyword="sender")
        def Set(self, interface, prop, value, sender=None):
            guard(sender, "Item.Set")

    class PortalSecret(dbus.service.Object):
        @dbus.service.method(IF_PORTAL_SECRET, in_signature="osha{sv}",
                             out_signature="ua{sv}", sender_keyword="sender")
        def RetrieveSecret(self, _handle, app_id, fd, _options, sender=None):
            guard_portal(sender)
            app = str(app_id)
            if app.lower() not in CHROME_APP_IDS:
                print(f"{APP}: portal deny app_id={app!r}", flush=True)
                state.denied += 1
                state.last_denied = {"sender": "portal", "at": time.time(),
                                     "where": f"RetrieveSecret: app_id {app!r}"}
                return portal_result(2)
            if state.secret is None:
                print(f"{APP}: portal request while locked", flush=True)
                state.denied += 1
                state.last_denied = {"sender": "portal", "at": time.time(),
                                     "where": "RetrieveSecret: vault locked"}
                return portal_result(2)

            raw = None
            pid = None
            try:
                raw = fd.take() if hasattr(fd, "take") else int(fd)
                try:
                    why, ours = state.check_request(raw)
                except Exception as e:
                    why, ours = f"verification error: {e}", True
                if why:
                    print(f"{APP}: portal call refused: {why}", flush=True)
                    state.denied += 1
                    state.last_denied = {"sender": "portal", "at": time.time(),
                                         "where": f"RetrieveSecret: {why}",
                                         "ours": ours}
                    if ours:
                        state.wipe()  # Chrome itself was refused: lock
                    return portal_result(2)
                pid = state.grant["pid"]
                secret = bytes(state.secret)
                off = 0
                while off < len(secret):
                    n = os.write(raw, secret[off:])
                    if n <= 0:
                        raise OSError("short write")
                    off += n
            except Exception as e:
                print(f"{APP}: portal write failed: {e}", flush=True)
                return portal_result(2)
            finally:
                if raw is not None:
                    try:
                        os.close(raw)
                    except OSError:
                        pass

            state.last_portal = {"app_id": app, "pid": pid, "at": time.time()}
            state.wipe()  # one key per unlock: lock immediately
            print(f"{APP}: portal secret delivered to verified Chrome pid {pid} "
                  f"(app_id={app!r}); vault locked", flush=True)
            return portal_result(0)

        @dbus.service.method(IF_PROPS, in_signature="ss", out_signature="v",
                             sender_keyword="sender")
        def Get(self, interface, prop, sender=None):
            guard_portal(sender)
            if prop == "version":
                return dbus.UInt32(1)
            raise dbus.exceptions.DBusException(
                f"no such property {prop}",
                name="org.freedesktop.DBus.Error.InvalidArgs")

        @dbus.service.method(IF_PROPS, in_signature="s", out_signature="a{sv}",
                             sender_keyword="sender")
        def GetAll(self, interface, sender=None):
            guard_portal(sender)
            return {"version": dbus.UInt32(1)}

    return (
        SecretService(bus, SERVICE_PATH),
        Collection(bus, COLLECTION_PATH),
        Item(bus, ITEM_PATH),
        PortalSecret(bus, PORTAL_PATH),
    )


