def die(msg, code=1):
    if sys.stderr.isatty():
        print(f"{APP}: {msg}", file=sys.stderr)
    else:
        # launched from a desktop file: stderr goes nowhere, so surface the
        # failure as a desktop notification
        notify(msg)
    sys.exit(code)


def ensure_dir():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(CONFIG_DIR, 0o700)


def write_private(path: Path, data: bytes):
    """Write atomically with 0600, without following planted symlinks."""
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=path.name + ".",
                               suffix=".tmp")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    try:
        dfd = os.open(str(path.parent), os.O_DIRECTORY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except OSError:
        pass


def find_chrome():
    for c in CHROME_BINARIES:
        if os.path.isfile(c):
            return c
    return None


def real_home():
    import pwd
    return pwd.getpwuid(os.getuid()).pw_dir


def trusted_path(path):
    """None if path and every parent are root-owned, not symlinks, and not
    group/world-writable (so only root can swap the file). Else a reason."""
    p = Path(path)
    for q in [p] + list(p.parents):
        try:
            st = os.lstat(q)
        except OSError as e:
            return f"{q}: {e}"
        if stat.S_ISLNK(st.st_mode):
            return f"{q} is a symlink"
        if st.st_uid != 0:
            return f"{q} is not root-owned"
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            return f"{q} is group/world-writable"
    return None


def chrome_argv_problems(argv, exe):
    """None if argv is exe + allowed flags + plain URLs/paths."""
    if not argv or argv[0] != exe:
        return f"argv[0] {argv[:1]!r} is not {exe}"
    for a in argv[1:]:
        if not a.startswith("-"):
            continue  # URL or file to open
        if a == f"--enable-features={CHROME_FEATURE}":
            continue
        if a in ALLOWED_CHROME_FLAGS or a.startswith(ALLOWED_CHROME_FLAG_PREFIXES):
            continue
        return f"Chrome flag {a!r} is not allowed"
    return None


def chrome_env_problems(env):
    """None if env cannot inject code into Chrome or move its profile."""
    bad = sorted(k for k in env if k.startswith(CHROME_ENV_BLOCK))
    if bad:
        return f"dangerous environment variables: {', '.join(bad)}"
    home = real_home()
    if env.get("HOME") != home:
        return f"HOME={env.get('HOME')!r} is not {home!r}"
    xch = env.get("XDG_CONFIG_HOME")
    if xch is not None and os.path.normpath(xch) != os.path.join(home, ".config"):
        return f"XDG_CONFIG_HOME={xch!r} moves the Chrome profile"
    return None


def chrome_env(environ):
    """Clean environment for launching Chrome: drop blocked variables and
    a profile-moving XDG_CONFIG_HOME. Returns (env, removed_names)."""
    home = real_home()
    env, removed = {}, []
    for k, v in environ.items():
        if k.startswith(CHROME_ENV_BLOCK):
            removed.append(k)
            continue
        if k == "XDG_CONFIG_HOME" and os.path.normpath(v) != os.path.join(home, ".config"):
            removed.append(k)
            continue
        env[k] = v
    env["HOME"] = home
    return env, removed


def read_proc_status(pid):
    out = {}
    with open(f"/proc/{pid}/status") as f:
        for line in f:
            k, _, v = line.partition(":")
            out[k] = v.split()
    return out


def describe_pid(pid):
    try:
        return f"{pid}:{os.readlink(f'/proc/{pid}/exe')}"
    except OSError:
        try:
            with open(f"/proc/{pid}/comm") as f:
                return f"{pid}:({f.read().strip()})"
        except OSError:
            return f"{pid}:?"


def verify_chrome_process(pid):
    """None if pid is a clean, real Chrome browser process; else a reason.
    Needs a daemon without a private user/mount namespace (see the unit)."""
    base = f"/proc/{int(pid)}"
    try:
        exe = os.readlink(f"{base}/exe")
        if exe not in CHROME_BINARIES:
            return f"exe {exe!r} is not Chrome"
        why = trusted_path(exe)
        if why:
            return why
        run, disk = os.stat(f"{base}/exe"), os.stat(exe)
        if (run.st_dev, run.st_ino) != (disk.st_dev, disk.st_ino):
            return "running image is not the Chrome binary on disk"
        for ns in ("mnt", "user", "pid"):
            if os.readlink(f"{base}/ns/{ns}") != os.readlink(f"/proc/self/ns/{ns}"):
                return f"Chrome runs in a different {ns} namespace"
        if os.readlink(f"{base}/root") != "/":
            return "Chrome is chrooted"
        st = read_proc_status(pid)
        if st.get("TracerPid", ["0"])[0] != "0":
            return "Chrome is being traced"
        if any(u != str(os.getuid()) for u in st.get("Uid", ["?"])):
            return "Chrome uid mismatch"
        with open(f"{base}/cmdline", "rb") as f:
            argv = [a.decode("utf-8", "surrogateescape")
                    for a in f.read().split(b"\0")[:-1]]
        why = chrome_argv_problems(argv, exe)
        if why:
            return why
        with open(f"{base}/environ", "rb") as f:
            env = {}
            for item in f.read().split(b"\0"):
                k, sep, v = item.partition(b"=")
                if sep:
                    env[k.decode("utf-8", "surrogateescape")] = \
                        v.decode("utf-8", "surrogateescape")
        return chrome_env_problems(env)
    except OSError as e:
        return f"cannot inspect pid {pid}: {e}"


def pipe_readers(fd):
    """Every process (other than us) holding the read end of the anonymous
    pipe whose write end is fd. Anyone holding it can read the key.
    Returns (reader_pids, hidden_pids): hidden = same-uid processes whose
    fd table we cannot inspect (non-dumpable)."""
    st = os.fstat(fd)
    target = f"pipe:[{st.st_ino}]"
    if not stat.S_ISFIFO(st.st_mode) or os.readlink(f"/proc/self/fd/{fd}") != target:
        raise ValueError("portal fd is not an anonymous pipe")
    me, uid = os.getpid(), str(os.getuid())
    readers, hidden = set(), []
    for name in os.listdir("/proc"):
        if not name.isdigit() or int(name) == me:
            continue
        pid = int(name)
        try:
            fds = os.listdir(f"/proc/{pid}/fd")
        except FileNotFoundError:
            continue
        except PermissionError:
            try:
                if read_proc_status(pid).get("Uid", [""])[0] == uid:
                    hidden.append(pid)
            except OSError:
                pass
            continue
        for n in fds:
            try:
                if os.readlink(f"/proc/{pid}/fd/{n}") != target:
                    continue
            except OSError:
                continue
            try:
                with open(f"/proc/{pid}/fdinfo/{n}") as f:
                    flags = next(int(l.split()[1], 8) for l in f
                                 if l.startswith("flags:"))
            except (OSError, StopIteration, ValueError):
                readers.add(pid)  # unknown mode: assume it can read
                continue
            if flags & os.O_ACCMODE != os.O_WRONLY:
                readers.add(pid)
    return readers, hidden


def chrome_args(args):
    """Return Chrome argv with CHROME_FEATURE enabled. Chrome only honours
    the last --enable-features, so merge into an existing one."""
    out, merged = [], False
    for a in args:
        if a.startswith("--enable-features="):
            feats = [f for f in a.split("=", 1)[1].split(",") if f]
            if CHROME_FEATURE not in feats:
                feats.append(CHROME_FEATURE)
            a = "--enable-features=" + ",".join(feats)
            merged = True
        out.append(a)
    if not merged:
        out.insert(0, f"--enable-features={CHROME_FEATURE}")
    return out


def cookie_report():
    """Count cookie encryption prefixes per profile.
    v10 = public 'peanuts' key (unprotected), v11 = legacy keyring,
    v12 = portal key from mp35n (protected)."""
    import sqlite3
    report = []
    for root in CHROME_PROFILE_ROOTS:
        if not root.is_dir():
            continue
        for db in sorted(root.glob("*/Cookies")):
            counts = {}
            try:
                con = sqlite3.connect(f"file:{db}?mode=ro&immutable=1", uri=True)
                try:
                    for (v,) in con.execute("select encrypted_value from cookies"):
                        tag = bytes(v[:3]).decode("ascii", "replace") if v else "plain"
                        counts[tag] = counts.get(tag, 0) + 1
                finally:
                    con.close()
            except Exception as e:
                counts = {"error": str(e)}
            report.append((str(db.relative_to(Path.home())), counts))
    return report


