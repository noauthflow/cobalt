def write_private(path: Path, data: bytes):
    """Write atomically with 0600, without following planted symlinks."""
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=path.name + ".",
                               suffix=".tmp")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    try:
        dfd = os.open(str(path.parent), os.O_DIRECTORY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except OSError:
        pass


def find_chrome():
    for c in CHROME_BINARIES:
        if os.path.isfile(c):
            return c
    return None


def real_home():
    import pwd
    return pwd.getpwuid(os.getuid()).pw_dir


def trusted_path(path):
    """None if path and every parent are root-owned, not symlinks, and not
    group/world-writable (so only root can swap the file). Else a reason."""
    p = Path(path)
    for q in [p] + list(p.parents):
        try:
            st = os.lstat(q)
        except OSError as e:
            return f"{q}: {e}"
        if stat.S_ISLNK(st.st_mode):
            return f"{q} is a symlink"
        if st.st_uid != 0:
            return f"{q} is not root-owned"
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            return f"{q} is group/world-writable"
    return None


def chrome_argv_problems(argv, exe):
    """None if argv is exe + allowed flags + plain URLs/paths."""
    if not argv or argv[0] != exe:
        return f"argv[0] {argv[:1]!r} is not {exe}"
    for a in argv[1:]:
        if not a.startswith("-"):
            continue  # URL or file to open
        if a in (f"--enable-features={CHROME_FEATURE}", CHROME_OZONE):
            continue
        if a in ALLOWED_CHROME_FLAGS or a.startswith(ALLOWED_CHROME_FLAG_PREFIXES):
            continue
        return f"Chrome flag {a!r} is not allowed"
    if CHROME_OZONE not in argv[1:]:
        return f"Chrome was started without {CHROME_OZONE} (X11 is refused)"
    return None


def chrome_env_problems(env):
    """None if env cannot inject code into Chrome or move its profile."""
    bad = sorted(k for k in env if k.startswith(CHROME_ENV_BLOCK))
    if bad:
        return f"dangerous environment variables: {', '.join(bad)}"
    home = real_home()
    if env.get("HOME") != home:
        return f"HOME={env.get('HOME')!r} is not {home!r}"
    xch = env.get("XDG_CONFIG_HOME")
    if xch is not None and os.path.normpath(xch) != os.path.join(home, ".config"):
        return f"XDG_CONFIG_HOME={xch!r} moves the Chrome profile"
    return None


def chrome_env(environ):
    """Clean environment for launching Chrome: drop blocked variables and
    a profile-moving XDG_CONFIG_HOME. Returns (env, removed_names)."""
    home = real_home()
    env, removed = {}, []
    for k, v in environ.items():
        if k.startswith(CHROME_ENV_BLOCK):
            removed.append(k)
            continue
        if k == "XDG_CONFIG_HOME" and os.path.normpath(v) != os.path.join(home, ".config"):
            removed.append(k)
            continue
        env[k] = v
    env["HOME"] = home
    return env, removed


def read_proc_status(pid):
    out = {}
    with open(f"/proc/{pid}/status") as f:
        for line in f:
            k, _, v = line.partition(":")
            out[k] = v.split()
    return out


def describe_pid(pid):
    try:
        return f"{pid}:{os.readlink(f'/proc/{pid}/exe')}"
    except OSError:
        try:
            with open(f"/proc/{pid}/comm") as f:
                return f"{pid}:({f.read().strip()})"
        except OSError:
            return f"{pid}:?"


def verify_chrome_process(pid):
    """None if pid is a clean, real Chrome browser process; else a reason.
    Needs a daemon without a private user/mount namespace (see the unit)."""
    base = f"/proc/{int(pid)}"
    try:
        exe = os.readlink(f"{base}/exe")
        if exe not in CHROME_BINARIES:
            return f"exe {exe!r} is not Chrome"
        why = trusted_path(exe)
        if why:
            return why
        run, disk = os.stat(f"{base}/exe"), os.stat(exe)
        if (run.st_dev, run.st_ino) != (disk.st_dev, disk.st_ino):
            return "running image is not the Chrome binary on disk"
        for ns in ("mnt", "user", "pid"):
            if os.readlink(f"{base}/ns/{ns}") != os.readlink(f"/proc/self/ns/{ns}"):
                return f"Chrome runs in a different {ns} namespace"
        if os.readlink(f"{base}/root") != "/":
            return "Chrome is chrooted"
        st = read_proc_status(pid)
        if st.get("TracerPid", ["0"])[0] != "0":
            return "Chrome is being traced"
        if any(u != str(os.getuid()) for u in st.get("Uid", ["?"])):
            return "Chrome uid mismatch"
        with open(f"{base}/cmdline", "rb") as f:
            argv = [a.decode("utf-8", "surrogateescape")
                    for a in f.read().split(b"\0")[:-1]]
        why = chrome_argv_problems(argv, exe)
        if why:
            return why
        with open(f"{base}/environ", "rb") as f:
            env = {}
            for item in f.read().split(b"\0"):
                k, sep, v = item.partition(b"=")
                if sep:
                    env[k.decode("utf-8", "surrogateescape")] = \
                        v.decode("utf-8", "surrogateescape")
        return chrome_env_problems(env)
    except OSError as e:
        return f"cannot inspect pid {pid}: {e}"


def pipe_readers(fd):
    """Every process (other than us) holding the read end of the anonymous
    pipe whose write end is fd. Anyone holding it can read the key.
    Returns (reader_pids, hidden_pids): hidden = same-uid processes whose
    fd table we cannot inspect (non-dumpable)."""
    st = os.fstat(fd)
    target = f"pipe:[{st.st_ino}]"
    if not stat.S_ISFIFO(st.st_mode) or os.readlink(f"/proc/self/fd/{fd}") != target:
        raise ValueError("portal fd is not an anonymous pipe")
    me, uid = os.getpid(), str(os.getuid())
    readers, hidden = set(), []
    for name in os.listdir("/proc"):
        if not name.isdigit() or int(name) == me:
            continue
        pid = int(name)
        try:
            fds = os.listdir(f"/proc/{pid}/fd")
        except FileNotFoundError:
            continue
        except PermissionError:
            try:
                if read_proc_status(pid).get("Uid", [""])[0] == uid:
                    hidden.append(pid)
            except OSError:
                pass
            continue
        for n in fds:
            try:
                if os.readlink(f"/proc/{pid}/fd/{n}") != target:
                    continue
            except OSError:
                continue
            try:
                with open(f"/proc/{pid}/fdinfo/{n}") as f:
                    flags = next(int(l.split()[1], 8) for l in f
                                 if l.startswith("flags:"))
            except (OSError, StopIteration, ValueError):
                readers.add(pid)  # unknown mode: assume it can read
                continue
            if flags & os.O_ACCMODE != os.O_WRONLY:
                readers.add(pid)
    return readers, hidden


# --------------------------------------------------------------------------
# delivery freeze
#
# Any process running as you can open /proc/<chrome>/fd/N (or the portal's
# or bus's copy of the pipe) and read the key while it sits in the pipe.
# So for the few milliseconds of a delivery every other process of yours is
# frozen (cgroup v2 freezer): a frozen process cannot run, so it cannot open
# or read anything. Only Chrome's own scope, the portal frontend and the
# session bus keep running (the key has to pass through them), and each of
# their processes is checked. The key is written, the daemon waits until
# Chrome has read every byte, then thaws. A frozen process that opened the
# pipe earlier finds it empty when it wakes up.
# --------------------------------------------------------------------------

CG_ROOT = "/sys/fs/cgroup"
BUSCTL = "/usr/bin/busctl"
SYSTEMD_RUN = "/usr/bin/systemd-run"
CHROME_SCOPE_PREFIX = "mp35n-chrome-"
# Chrome moves its browser process into a scope of its own (the portal reads
# the app ID from that name); its children stay in the mp35n-chrome scope.
CHROME_OWN_SCOPE = "app-com.google.Chrome-{pid}.scope"
# Chrome's crash reporter double-forks, so it is not Chrome's descendant.
CHROME_HELPERS = ("/opt/google/chrome/chrome_crashpad_handler",)
BUS_UNITS = {"dbus-broker.service": ("/usr/bin/dbus-broker-launch",
                                      "/usr/bin/dbus-broker"),
             "dbus.service": ("/usr/bin/dbus-daemon",)}
# Variables that load foreign code into the portal or the bus daemon.
INJECT_ENV_BLOCK = ("LD_", "GLIBC_TUNABLES", "MALLOC_", "GCONV_PATH",
                    "GIO_EXTRA_MODULES", "GIO_MODULE_DIR", "GTK_MODULES",
                    "GTK3_MODULES", "GTK_PATH", "GDK_PIXBUF_MODULE",
                    "G_SLICE", "G_DEBUG")
FREEZE_TIMEOUT = 2.0    # s until every frozen cgroup reports frozen
DRAIN_TIMEOUT = 5.0     # s for Chrome to read the key before we thaw anyway
WATCHDOG = 10.0         # s hard limit: thaw from a thread no matter what


def user_cg_root():
    uid = os.getuid()
    return f"/user.slice/user-{uid}.slice"


def user_manager_cg():
    uid = os.getuid()
    return f"{user_cg_root()}/user@{uid}.service"


def proc_cgroup(pid):
    with open(f"/proc/{pid}/cgroup") as f:
        for line in f:
            if line.startswith("0::"):
                return line[3:].rstrip("\n")
    raise OSError(f"pid {pid} has no cgroup v2 entry")


def proc_ppid(pid):
    with open(f"/proc/{pid}/stat") as f:
        return int(f.read().rsplit(")", 1)[1].split()[1])


def is_descendant(pid, root):
    for _ in range(128):
        if pid == root:
            return True
        if pid <= 1:
            return False
        pid = proc_ppid(pid)
    return False


def cg_procs(cg):
    try:
        with open(f"{CG_ROOT}{cg}/cgroup.procs") as f:
            return [int(x) for x in f.read().split()]
    except FileNotFoundError:
        return []


def cg_frozen(cg):
    try:
        with open(f"{CG_ROOT}{cg}/cgroup.events") as f:
            return any(l.split() == ["frozen", "1"] for l in f)
    except OSError:
        return False


def cg_freeze_flag(cg):
    try:
        with open(f"{CG_ROOT}{cg}/cgroup.freeze") as f:
            return f.read().strip() == "1"
    except OSError:
        return False


def cg_children(cg):
    try:
        return sorted(f"{cg}/{e.name}" for e in os.scandir(f"{CG_ROOT}{cg}")
                      if e.is_dir(follow_symlinks=False))
    except OSError:
        return []


def cg_walk(cg):
    yield cg
    for c in cg_children(cg):
        yield from cg_walk(c)


def cg_write_freeze(cg, value):
    with open(f"{CG_ROOT}{cg}/cgroup.freeze", "w") as f:
        f.write("1" if value else "0")


def session_scopes():
    """Login session scopes (root-owned; frozen via systemd + polkit)."""
    return [c for c in cg_children(user_cg_root())
            if c.rsplit("/", 1)[-1].startswith("session-")
            and c.endswith(".scope")]


def systemctl_freezer(verb, unit):
    """FreezeUnit/ThawUnit on the system manager (polkit: 50-mp35n.rules).
    Not `systemctl freeze`: that also takes a unit reference (Ref), which
    needs a second authorization. The reply comes once the unit is frozen."""
    method = {"freeze": "FreezeUnit", "thaw": "ThawUnit"}[verb]
    r = subprocess.run([BUSCTL, "--system", "--timeout=5", "call",
                        "org.freedesktop.systemd1", "/org/freedesktop/systemd1",
                        "org.freedesktop.systemd1.Manager", method, "s", unit],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.PIPE, timeout=FREEZE_TIMEOUT + 3,
                       env={"PATH": "/usr/bin:/bin", "LANG": "C"})
    if r.returncode != 0:
        raise OSError(r.stderr.decode(errors="replace").strip()
                      or f"{method} {unit} failed")


def proc_uid_match(pid, uid):
    try:
        return str(uid) in read_proc_status(pid).get("Uid", [])
    except OSError:
        return False


def read_environ_names(pid):
    with open(f"/proc/{pid}/environ", "rb") as f:
        return [item.partition(b"=")[0].decode("utf-8", "surrogateescape")
                for item in f.read().split(b"\0") if item]


def verify_helper_process(pid, binaries):
    """None if pid runs one of the root-owned binaries with no code-loading
    environment and is not traced. Else a reason."""
    try:
        exe = os.readlink(f"/proc/{pid}/exe")
    except OSError as e:
        return f"cannot inspect pid {pid}: {e}"
    if exe not in binaries:
        return f"pid {pid} runs {exe!r}"
    why = trusted_path(exe)
    if why:
        return f"pid {pid}: {why}"
    try:
        if read_proc_status(pid).get("TracerPid", ["0"])[0] != "0":
            return f"pid {pid} is being traced"
        bad = sorted(k for k in read_environ_names(pid)
                     if k.startswith(INJECT_ENV_BLOCK))
    except OSError as e:
        return f"cannot inspect pid {pid}: {e}"
    if bad:
        return f"pid {pid} ({exe}) has {', '.join(bad)} in its environment"
    return None


class DeliveryFreeze:
    """Freeze every process of this uid except Chrome's scope, the portal
    frontend and the session bus; audit what is left running; thaw."""

    def __init__(self, chrome_pid, portal_pid, launch_scope):
        self.uid = os.getuid()
        self.chrome_pid = chrome_pid
        self.launch_scope = launch_scope   # cgroup `35 run` started Chrome in
        self.portal_pid = portal_pid
        self.frozen_cgs = []       # we wrote cgroup.freeze=1 here
        self.frozen_units = []     # we ran `systemctl freeze` on these
        self.exempt = {}           # cgroup -> "chrome" | binaries tuple
        self.started = None
        self._thawed = False
        import threading
        self._lock = threading.Lock()

    # -- exempt set ---------------------------------------------------------

    def _find_exempt(self):
        mgr = user_manager_cg()
        apps = f"{mgr}/app.slice"
        own = f"{apps}/{CHROME_OWN_SCOPE.format(pid=self.chrome_pid)}"
        launch = self.launch_scope
        if (not launch or launch.rsplit("/", 1)[0] != apps
                or not launch.rsplit("/", 1)[-1].startswith(CHROME_SCOPE_PREFIX)
                or not launch.endswith(".scope")):
            return (f"Chrome was not started in its own {CHROME_SCOPE_PREFIX}*"
                    f".scope (got {launch!r}); start it with '35 run'")
        chrome_cg = proc_cgroup(self.chrome_pid)
        if chrome_cg not in (launch, own):
            return f"Chrome runs in {chrome_cg}, not {launch} or {own}"
        portal_cg = proc_cgroup(self.portal_pid)
        if (not portal_cg.startswith(mgr + "/")
                or not portal_cg.endswith("/" + PORTAL_UNIT)):
            return f"portal runs in {portal_cg}"
        bus = [(cg, BUS_UNITS[cg.rsplit("/", 1)[-1]]) for cg in cg_walk(mgr)
               if cg.rsplit("/", 1)[-1] in BUS_UNITS and cg_procs(cg)]
        if len(bus) != 1:
            return f"cannot identify the session bus cgroup: {bus!r}"
        self.exempt = {launch: "chrome", own: "chrome",
                       portal_cg: PORTAL_BINARIES, bus[0][0]: bus[0][1]}
        return None

    # -- freeze / thaw ------------------------------------------------------

    def _freeze_tree(self, cg):
        for c in cg_children(cg):
            if c in self.exempt:
                continue
            if any(e.startswith(c + "/") for e in self.exempt):
                self._freeze_tree(c)
                continue
            if cg_freeze_flag(c):
                continue  # already frozen by someone else; leave it
            cg_write_freeze(c, True)
            self.frozen_cgs.append(c)

    def freeze(self):
        """None once everything else is frozen and audited; else a reason
        (the caller must still call thaw())."""
        self.started = time.monotonic()
        try:
            why = self._find_exempt()
            if why:
                return why
            self._freeze_tree(user_manager_cg())
            for sc in session_scopes():
                if not any(proc_uid_match(p, self.uid) for p in cg_procs(sc)):
                    continue
                if cg_freeze_flag(sc):
                    continue
                unit = sc.rsplit("/", 1)[-1]
                try:
                    systemctl_freezer("freeze", unit)
                except Exception as e:
                    return (f"cannot freeze {unit}: {e} (is "
                            "/etc/polkit-1/rules.d/50-mp35n.rules installed?)")
                self.frozen_units.append(sc)
        except OSError as e:
            return f"freeze failed: {e}"
        deadline = time.monotonic() + FREEZE_TIMEOUT
        pending = list(self.frozen_cgs) + list(self.frozen_units)
        while pending:
            pending = [c for c in pending if cg_procs_any(c) and not cg_frozen(c)]
            if not pending:
                break
            if time.monotonic() > deadline:
                return f"did not freeze in time: {', '.join(pending)}"
            time.sleep(0.002)
        return self.audit()

    def thaw(self):
        with self._lock:
            if self._thawed:
                return []
            self._thawed = True
        errors = []
        for c in reversed(self.frozen_cgs):
            try:
                cg_write_freeze(c, False)
            except OSError as e:
                if os.path.isdir(f"{CG_ROOT}{c}"):
                    errors.append(f"{c}: {e}")
        for sc in self.frozen_units:
            try:
                systemctl_freezer("thaw", sc.rsplit("/", 1)[-1])
            except Exception as e:
                errors.append(f"{sc}: {e}")
        for e in errors:
            print(f"{APP}: THAW FAILED {e}", flush=True)
        return errors

    def elapsed_ms(self):
        return int((time.monotonic() - self.started) * 1000) if self.started else 0

    # -- audit --------------------------------------------------------------

    def audit(self):
        """None if every running process of this uid is the daemon itself,
        Chrome or its children in Chrome's scope, the verified portal, or
        the verified session bus. Everything else must be frozen."""
        me = os.getpid()
        for name in os.listdir("/proc"):
            if not name.isdigit():
                continue
            pid = int(name)
            if pid == me or not proc_uid_match(pid, self.uid):
                continue
            try:
                cg = proc_cgroup(pid)
                kind = self.exempt.get(cg)
                if kind == "chrome":
                    if (not is_descendant(pid, self.chrome_pid)
                            and verify_helper_process(pid, CHROME_HELPERS)):
                        return (f"{describe_pid(pid)} sits in Chrome's scope "
                                "but is not Chrome's child")
                    continue
                if kind is not None:
                    why = verify_helper_process(pid, kind)
                    if why:
                        return f"unexpected process in {cg}: {why}"
                    continue
                if not cg_frozen(cg):
                    return f"{describe_pid(pid)} in {cg} is not frozen"
            except FileNotFoundError:
                continue  # exited
            except OSError as e:
                if os.path.exists(f"/proc/{pid}"):
                    return f"cannot audit pid {pid}: {e}"
        return None


def cg_procs_any(cg):
    """True if cg or a descendant has processes (an empty cgroup never
    reports frozen on some kernels, so it is not waited for)."""
    try:
        with open(f"{CG_ROOT}{cg}/cgroup.events") as f:
            return any(l.split() == ["populated", "1"] for l in f)
    except OSError:
        return False


def thaw_leftovers():
    """After a crash mid-delivery: thaw what a delivery may have frozen."""
    for cg in cg_walk(user_manager_cg()):
        if cg != user_manager_cg() and cg_freeze_flag(cg):
            try:
                cg_write_freeze(cg, False)
                print(f"{APP}: thawed leftover {cg}", flush=True)
            except OSError:
                pass
    for sc in session_scopes():
        if cg_freeze_flag(sc):
            try:
                systemctl_freezer("thaw", sc.rsplit("/", 1)[-1])
                print(f"{APP}: thawed leftover {sc}", flush=True)
            except Exception as e:
                print(f"{APP}: cannot thaw {sc}: {e}", flush=True)


def chrome_args(args):
    """Return Chrome argv with CHROME_FEATURE enabled. Chrome only honours
    the last --enable-features, so merge into an existing one."""
    out, merged = [], False
    for a in args:
        if a.startswith("--ozone-platform"):
            continue  # replaced by CHROME_OZONE
        if a.startswith("--enable-features="):
            feats = [f for f in a.split("=", 1)[1].split(",") if f]
            if CHROME_FEATURE not in feats:
                feats.append(CHROME_FEATURE)
            a = "--enable-features=" + ",".join(feats)
            merged = True
        out.append(a)
    if not merged:
        out.insert(0, f"--enable-features={CHROME_FEATURE}")
    return [CHROME_OZONE] + out


def cookie_report():
    """Count cookie encryption prefixes per profile.
    v10 = public 'peanuts' key (unprotected), v11 = legacy keyring,
    v12 = portal key from mp35n (protected)."""
    import sqlite3
    report = []
    for root in CHROME_PROFILE_ROOTS:
        if not root.is_dir():
            continue
        for db in sorted(root.glob("*/Cookies")):
            counts = {}
            try:
                con = sqlite3.connect(f"file:{db}?mode=ro&immutable=1", uri=True)
                try:
                    for (v,) in con.execute("select encrypted_value from cookies"):
                        tag = bytes(v[:3]).decode("ascii", "replace") if v else "plain"
                        counts[tag] = counts.get(tag, 0) + 1
                finally:
                    con.close()
            except Exception as e:
                counts = {"error": str(e)}
            report.append((str(db.relative_to(Path.home())), counts))
    return report


CHROME_POLICY_DIRS = (Path("/etc/opt/chrome/policies/managed"),
                      Path("/etc/opt/chrome/policies/recommended"))
# Extension install locations Chrome ships itself (component / external
# component); not interesting in a status listing.
BUILTIN_EXT_LOCATIONS = {5, 10}


def chrome_policies():
    """[(path, trust_problem_or_None, dict_or_error_str)] for every policy
    file, plus the merged managed policy dict."""
    files, managed = [], {}
    for d in CHROME_POLICY_DIRS:
        if not d.is_dir():
            continue
        for f in sorted(d.glob("*.json")):
            try:
                data = json.loads(f.read_text())
                if not isinstance(data, dict):
                    raise ValueError("not a JSON object")
            except (OSError, ValueError) as e:
                data = f"unreadable: {e}"
            files.append((f, trusted_path(f), data))
            if d.name == "managed" and isinstance(data, dict):
                managed.update(data)
    return files, managed


def extension_policy(ext_id, pol):
    """'allowed' / 'blocked' / 'forced' for ext_id under the managed policy."""
    es = pol.get("ExtensionSettings") or {}
    mode = (es.get(ext_id) or {}).get("installation_mode")
    if mode in ("blocked", "removed") or ext_id in (pol.get("ExtensionInstallBlocklist") or []):
        return "blocked"
    if mode in ("force_installed", "normal_installed") \
            or ext_id in (pol.get("ExtensionInstallForcelist") or []):
        return "forced"
    if mode == "allowed" or ext_id in (pol.get("ExtensionInstallAllowlist") or []):
        return "allowed"
    if default_extensions_blocked(pol):
        return "blocked"
    return "allowed"


def default_extensions_blocked(pol):
    es = pol.get("ExtensionSettings") or {}
    return ((es.get("*") or {}).get("installation_mode") in ("blocked", "removed")
            or "*" in (pol.get("ExtensionInstallBlocklist") or []))


def _strip_json_comments(text):
    """Drop // and /* */ comments outside strings (Chrome's manifest parser
    accepts them, json does not)."""
    out, i, n, in_str = [], 0, len(text), False
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(text[i + 1])
                i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
            out.append(c)
        elif text.startswith("//", i):
            j = text.find("\n", i)
            i = n if j < 0 else j
            continue
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            i = n if j < 0 else j + 2
            continue
        else:
            out.append(c)
        i += 1
    return "".join(out)


def _manifest_name(ext_dir):
    try:
        m = json.loads(_strip_json_comments(
            (ext_dir / "manifest.json").read_text(encoding="utf-8-sig")))
    except (OSError, ValueError):
        return None
    name = m.get("name") or ""
    if name.startswith("__MSG_") and name.endswith("__"):
        key = name[6:-2].lower()
        loc = m.get("default_locale") or "en"
        try:
            msgs = json.loads((ext_dir / "_locales" / loc / "messages.json")
                              .read_text(encoding="utf-8-sig"))
            name = next((v.get("message") for k, v in msgs.items()
                         if k.lower() == key), name)
        except (OSError, ValueError):
            pass
    return name or None


def extension_report():
    """[(profile, [(id, name, enabled, source)])] for user-visible
    extensions in every Chrome profile."""
    root = CHROME_PROFILE_ROOTS[0]
    out = []
    if not root.is_dir():
        return out
    for prefs in sorted(root.glob("*/Preferences")):
        prof = prefs.parent
        settings = {}
        for f in (prefs, prof / "Secure Preferences"):
            try:
                d = json.loads(f.read_text())
                settings.update(d.get("extensions", {}).get("settings", {}) or {})
            except (OSError, ValueError, AttributeError):
                pass
        exts = []
        for ext_id, s in sorted(settings.items()):
            loc = s.get("location")
            if loc is None or loc in BUILTIN_EXT_LOCATIONS:
                continue
            path = s.get("path") or ""
            if loc == 4:  # unpacked: path is the source folder
                ext_dir, source = Path(path), f"unpacked {path.replace(str(Path.home()), '~')}"
            else:
                ext_dir = prof / "Extensions" / path
                source = "web store" if s.get("from_webstore") else f"location {loc}"
            name = (s.get("manifest") or {}).get("name") or _manifest_name(ext_dir) or "?"
            reasons = s.get("disable_reasons")
            enabled = s.get("state", 1) != 0 and not reasons
            exts.append((ext_id, name, enabled, source))
        out.append((prof.name, exts))
    return out


def _color_on():
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR") \
        and os.environ.get("TERM") != "dumb"


def paint(text, color):
    codes = {"green": "32", "red": "31", "yellow": "33", "dim": "2", "bold": "1"}
    return f"\033[{codes[color]}m{text}\033[0m" if _color_on() else str(text)


def status_row(label, value, note=None):
    print(f"  {label:<11} {value}" + (f"  {paint(note, 'dim')}" if note else ""))


def status_warn(text, color="red"):
    print(f"  {'':<11} {paint(text, color)}")


def print_chrome_policy_status():
    files, pol = chrome_policies()
    for f, trust, data in files:
        if trust or not isinstance(data, dict):
            status_row("policy", paint(f"{f}: {trust or data}", "red"))

    print()
    locked = default_extensions_blocked(pol)
    status_row("extensions", paint("locked", "green") if locked
               else paint("not locked", "red"),
               None if locked else "any extension can be installed")
    reports = extension_report()
    width = max((len(e[1]) for _, exts in reports for e in exts), default=0)
    for prof, exts in reports:
        if len(reports) > 1:
            print(f"    {paint(prof, 'dim')}")
        for ext_id, name, enabled, source in exts:
            if extension_policy(ext_id, pol) == "blocked":
                mark, tag = paint("\u2717", "red"), "blocked"
            elif enabled:
                mark, tag = paint("\u25cf", "green"), ""
            else:
                mark, tag = paint("\u25cb", "dim"), "off"
            where = source[len("unpacked "):] if source.startswith("unpacked ") else ""
            extra = "  ".join(x for x in (tag, where) if x)
            print(f"    {mark} {name:<{width}}" + (f"  {paint(extra, 'dim')}" if extra else ""))

    print()
    ok = all(pol.get(k) == v for k, v in NETWORK_POLICY.items())
    status_row("network", paint("locked", "green") if ok else paint("not locked", "red"),
               None if ok else "run ~/cobalt/mp35n/chrome-policy/apply-policy.sh")
    width = max(len(k) for k in NETWORK_POLICY)
    for k, v in NETWORK_POLICY.items():
        good = pol.get(k) == v
        mark = paint("\u2713", "green") if good else paint("\u2717", "red")
        print(f"    {mark} {k:<{width}}  {paint(json.dumps(v), 'dim')}")


def b64e(b):
    return base64.b64encode(b).decode("ascii")


def b64d(s):
    return base64.b64decode(s.encode("ascii"))


def vault_phrase():
    """The codeword shown in the unlock prompt."""
    return "KANEKI"


def scrypt_key(password: str, salt: bytes, n, r, p) -> bytes:
    return hashlib.scrypt(
        password.encode("utf-8"),
        salt=salt,
        n=n, r=r, p=p,
        dklen=32,
        maxmem=SCRYPT_MAXMEM,
    )


# --------------------------------------------------------------------------
# vault
# --------------------------------------------------------------------------

def seal(password: str, secret: bytes) -> dict:
    """Encrypt the key under password: scrypt KEK + AES-256-GCM."""
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    salt = os.urandom(16)
    key = scrypt_key(password, salt, SCRYPT_N, SCRYPT_R, SCRYPT_P)
    nonce = os.urandom(12)
    ct = AESGCM(key).encrypt(nonce, secret, VAULT_AAD)
    return {
        "kind": "mp35n-vault",
        "version": 1,
        "kdf": {"name": "scrypt", "n": SCRYPT_N, "r": SCRYPT_R, "p": SCRYPT_P,
                "salt": b64e(salt)},
        "cipher": {"name": "aes-256-gcm", "nonce": b64e(nonce), "ct": b64e(ct)},
        "created": int(time.time()),
    }


def unseal(doc: dict, password: str) -> bytes:
    """Inverse of seal(). Raises on a wrong password or a bad document."""
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    if doc.get("kind", "mp35n-vault") != "mp35n-vault":
        raise ValueError("not an mp35n vault")
    kdf, c = doc["kdf"], doc["cipher"]
    if kdf.get("name") != "scrypt" or c.get("name") != "aes-256-gcm":
        raise ValueError("unsupported kdf/cipher")
    key = scrypt_key(password, b64d(kdf["salt"]), kdf["n"], kdf["r"], kdf["p"])
    secret = AESGCM(key).decrypt(b64d(c["nonce"]), b64d(c["ct"]), VAULT_AAD)
    if len(secret) != SECRET_LEN:
        raise ValueError("secret has the wrong length")
    return secret


