def ask_confirm(message, default=False):
    """Yes/no question via the terminal or GTK; never via a shell helper."""
    if sys.stdin.isatty() or STDIN_PASSWORD:
        suffix = " [Y/n] " if default else " [y/N] "
        try:
            answer = input(message + suffix).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return False
        if not answer:
            return default
        return answer in ("y", "yes")
    if not _gtk_ready():
        die("confirmation needs a terminal or a graphical display")
    return _gtk_confirm(message, default)


def prompt_new_password():
    """Ask for a new master password twice. Returns (password, error)."""
    if sys.stdin.isatty() or STDIN_PASSWORD:
        pw1 = getpass_password("New master password: ")
        if not pw1:
            return None, "empty password not allowed"
        pw2 = getpass_password("Repeat: ")
        if pw1 != pw2:
            return None, "passwords do not match"
        return pw1, None
    if not _gtk_ready():
        return None, "no graphical display; run from a terminal"
    try:
        pw = _gtk_new_password()
    except Exception as e:
        return None, f"GTK prompt failed: {e}"
    if pw is None:
        return None, "cancelled"
    return pw, None


def getpass_password(prompt):
    if STDIN_PASSWORD:
        line = sys.stdin.readline()
        if not line:
            return None
        return line.rstrip("\n")
    import getpass
    try:
        return getpass.getpass(prompt)
    except (EOFError, KeyboardInterrupt):
        print()
        return None


def prompt_unlock(verify):
    """Ask for the master password via the terminal or native GTK.
    verify(password) -> (ok, error). Returns (ok, error)."""
    if sys.stdin.isatty() or STDIN_PASSWORD:
        err = None
        for attempt in range(3):
            prompt = "Master password:"
            if err:
                prompt = f"{err} — try again ({attempt + 1}/3):"
            password = getpass_password(prompt)
            if password is None:
                return False, "no password entered"
            ok, why = verify(password)
            if ok:
                return True, None
            err = why
            if "too many attempts" in (err or ""):
                return False, err
            print(f"{APP}: {err} (attempt {attempt + 1}/3)", file=sys.stderr)
        return False, err or "unlock failed"

    if not _gtk_ready():
        return False, "no graphical display; run from a terminal"
    try:
        return _gtk_unlock(verify)
    except Exception as e:
        return False, f"GTK prompt failed: {e}"


def cmd_lock(args):
    r = daemon_call({"cmd": "lock"})
    if r is None:
        if try_start_daemon():
            r = daemon_call({"cmd": "lock"})
    if r is None:
        die("daemon is not running")
    if not r.get("ok"):
        die(r.get("error", "lock failed"))
    print(f"{APP}: locked")
    return 0


def chrome_running():
    """PID of the Chrome browser that owns the default profile, if alive."""
    for root in CHROME_PROFILE_ROOTS[:1]:
        try:
            target = os.readlink(root / "SingletonLock")  # "<host>-<pid>"
            pid = int(target.rsplit("-", 1)[1])
            if os.readlink(f"/proc/{pid}/exe") in CHROME_BINARIES:
                return pid
        except (OSError, ValueError, IndexError):
            pass
    return None


def cmd_run(args):
    """Unlock, launch Chrome with a clean argv/env, authorize exactly that
    process, wait for the key delivery (the daemon locks itself after it),
    then make sure the vault is locked. Works from a terminal or a .desktop
    entry."""
    chrome = find_chrome()
    if not chrome:
        die("no Chrome binary found at " + ", ".join(CHROME_BINARIES))
    why = trusted_path(chrome)
    if why:
        die(f"refusing to launch Chrome: {why}")
    argv = [chrome] + chrome_args(args)
    why = chrome_argv_problems(argv, chrome)
    if why:
        die(f"{why}; not starting chrome")
    env, removed = chrome_env(os.environ)
    if removed:
        notify("removed from Chrome's environment: " + ", ".join(sorted(removed)))

    if not VAULT_PATH.exists():
        os.execve(chrome, argv, env)  # nothing to protect

    if chrome_running():
        # The running browser already has its key; this process only hands
        # the URL/window request to it and exits. No unlock needed.
        os.execve(chrome, argv, env)

    require_daemon()
    # Always start from a fresh unlock: the launch token is only returned
    # to the client that supplied the password.
    daemon_call({"cmd": "lock"})
    token = {}

    def verify(pw):
        ur = daemon_call({"cmd": "unlock", "password": pw})
        if ur is None:
            return False, "daemon is not running"
        if ur.get("ok"):
            token["t"] = ur.get("token")
        return bool(ur.get("ok")), ur.get("error", "unlock failed")

    ok, why = prompt_unlock(verify)
    if not ok or not token.get("t"):
        die(f"{why or 'unlock failed'}; not starting chrome")

    started = time.time()
    proc = subprocess.Popen(
        argv, env=env, close_fds=True,
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True)
    ar = daemon_call({"cmd": "authorize", "token": token["t"], "pid": proc.pid})
    if not ar or not ar.get("ok"):
        # Kill it before it asks for the key and falls back to v10.
        proc.kill()
        daemon_call({"cmd": "lock"})
        die(f"Chrome failed verification: {(ar or {}).get('error', 'daemon gone')}; "
            "stopped it, vault locked")

    delivered = False
    refused = None
    seen_foreign = None
    deadline = time.time() + 20
    while time.time() < deadline:
        st2 = daemon_call({"cmd": "status"}) or {}
        lp = st2.get("last_portal")
        if lp and lp.get("at", 0) >= started and lp.get("pid") == proc.pid:
            delivered = True
            break
        ld = st2.get("last_denied") or {}
        if (ld.get("at", 0) >= started
                and str(ld.get("where", "")).startswith("RetrieveSecret")):
            if ld.get("ours"):
                refused = ld.get("where")
                break
            if ld.get("at") != (seen_foreign or {}).get("at"):
                # Someone else asked during our window. They got nothing;
                # keep waiting for Chrome, but tell the user.
                seen_foreign = ld
                notify(f"BLOCKED a key request that was not Chrome: {ld.get('where')}")
        if proc.poll() is not None:
            break  # existing instance took over, or a --version-style call
        time.sleep(0.2)

    if delivered:
        daemon_call({"cmd": "lock"})
        notify("key delivered to verified Chrome; vault locked again")
    elif refused:
        daemon_call({"cmd": "lock"})
        notify(f"PORTAL REFUSED ({refused}). Chrome is writing UNPROTECTED v10 "
               "cookies. Quit Chrome and check 'journalctl --user -u mp35n'.")
    elif proc.poll() is not None:
        daemon_call({"cmd": "lock"})  # exited without asking for the key
    else:
        # Chrome is running but never asked for the key. Locking now would
        # silently push it to v10 and destroy cookies, so stay unlocked.
        notify("key NOT confirmed delivered - vault stays UNLOCKED. "
               "run '35 lock' once chrome is up")
    return 0


def cmd_init(args):
    ensure_dir()
    if VAULT_PATH.exists() and "--force" not in args:
        die("vault already exists (use --force to wipe it)")

    chrome = find_chrome()
    if not chrome:
        print(f"{APP}: warning: no Chrome at {', '.join(CHROME_BINARIES)}",
              file=sys.stderr)

    pw1, why = prompt_new_password()
    if pw1 is None:
        die(why or "no password entered")
    if len(pw1) < 8:
        print(f"{APP}: warning: password shorter than 8 characters", file=sys.stderr)

    secret = os.urandom(SECRET_LEN)
    vault = vault_encrypt(pw1, secret)
    write_private(VAULT_PATH, json.dumps(vault, indent=2).encode("utf-8") + b"\n")

    print(f"{APP}: vault created at {VAULT_PATH}")
    print(f"{APP}: codeword: {vault_phrase()}")
    print(f"{APP}: next: '35 run' to start Chrome")
    return 0


def cmd_trust(args):
    print(f"{APP}: 'trust' is gone: Chrome is verified as the root-owned "
          f"{', '.join(CHROME_BINARIES)} on every request; nothing to re-pin.")
    return 0


USAGE = __doc__.strip()


def main(argv):
    global STDIN_PASSWORD
    if "--password-stdin" in argv:
        STDIN_PASSWORD = True
        argv = [a for a in argv if a != "--password-stdin"]
    if not argv:
        return cmd_status([])

    cmd, args = argv[0], argv[1:]
    if cmd in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    table = {
        "unlock": cmd_unlock,
        "lock": cmd_lock,
        "run": cmd_run,
        "status": cmd_status,
        "init": cmd_init,
        "trust": cmd_trust,
        "daemon": cmd_daemon,
    }
    fn = table.get(cmd)
    if not fn:
        print(USAGE)
        return 2
    return fn(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
