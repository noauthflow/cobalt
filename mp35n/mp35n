def cmd_daemon(args):
    try:
        import dbus
        import dbus.service
        import dbus.mainloop.glib
        from gi.repository import GLib
    except Exception as e:
        die(f"daemon needs dbus-python and pygobject: {e}")

    # Take the listening socket from systemd before anything else, so a copy
    # started any other way (D-Bus activation, by hand) exits before it can
    # grab the bus name.
    srv = systemd_listen_socket()
    if srv is None:
        die("the daemon must be started by systemd "
            "(sudo systemctl enable --now mp35n.socket mp35n.service)")

    # Non-dumpable: same-uid processes cannot open /proc/<daemon>/fd/* or
    # read its environ/maps. The daemon still reads its own /proc/self.
    import ctypes
    if ctypes.CDLL(None, use_errno=True).prctl(4, 0, 0, 0, 0) != 0:  # PR_SET_DUMPABLE
        die("prctl(PR_SET_DUMPABLE, 0) failed")

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)

    # A crash mid-delivery leaves your processes frozen; systemd restarts
    # us, and the first thing we do is thaw them.
    try:
        thaw_leftovers()
    except Exception as e:
        print(f"{APP}: thaw_leftovers: {e}", flush=True)

    state = State()
    verifier = Verifier()

    # Whoever owns the name answers Chrome's portal request and can hand it
    # a key of its choosing. If someone else holds it, stay up in the queue
    # (we take over when they let go), refuse unlocks, and alert.
    try:
        bus = dbus.SessionBus()
        name = dbus.service.BusName(
            SERVICE_NAME, bus=bus,
            do_not_queue=False, replace_existing=True, allow_replacement=False)
    except Exception as e:
        die(f"cannot connect to the session bus: {e}")
    me = bus.get_unique_name()

    def on_owner(owner):
        owner = str(owner or "")
        if owner == me:
            if not state.name_owned:
                print(f"{APP}: own {SERVICE_NAME}", flush=True)
            state.name_owned, state.name_owner = True, None
            return
        pid = verifier._pid_for_sender(owner) if owner else None
        who = describe_pid(pid) if pid else (owner or "nobody")
        was = state.name_owned or state.name_owner != who
        state.name_owned, state.name_owner = False, who
        state.wipe()
        if was:
            notify(name_squat_message(who))

    try:
        on_owner(bus.get_name_owner(SERVICE_NAME))
    except dbus.exceptions.DBusException:
        on_owner("")
    bus.watch_name_owner(SERVICE_NAME, on_owner)
    objects = build_dbus_objects(bus, state, verifier)

    # --- control socket (from mp35n.socket) -------------------------------
    srv.setblocking(False)
    state.srv = srv

    def handle_client(conn):
        try:
            raw = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                  struct.calcsize("3i"))
            _pid, uid, _gid = struct.unpack("3i", raw)
            if uid != os.getuid():
                conn.sendall(b'{"ok":false,"error":"peer uid mismatch"}\n')
                return
            conn.settimeout(5.0)
            data = b""
            while not data.endswith(b"\n"):
                chunk = conn.recv(4096)
                if not chunk:
                    break
                data += chunk
                if len(data) > 1 << 20:
                    break
            try:
                req = json.loads(data.decode("utf-8") or "{}")
            except Exception:
                req = {}
            resp = state.handle_control(req)
        except Exception as e:
            resp = {"ok": False, "error": str(e)}
        try:
            conn.sendall((json.dumps(resp) + "\n").encode("utf-8"))
        except Exception:
            pass
        finally:
            conn.close()

    def on_accept(fd, condition):
        try:
            conn, _ = srv.accept()
        except BlockingIOError:
            return True
        except OSError:
            return True
        handle_client(conn)
        return True

    GLib.io_add_watch(srv.fileno(), GLib.IO_IN, on_accept)

    loop = GLib.MainLoop()

    def on_signal(signum, frame):
        loop.quit()

    import signal
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    print(f"{APP}: daemon ready (name={SERVICE_NAME}, locked)", flush=True)
    try:
        loop.run()
    finally:
        state.wipe()
    return 0


def name_squat_message(owner):
    return (f"{SERVICE_NAME} is held by {owner or 'nobody'}, not mp35n. It "
            "would answer Chrome's key request; refusing to unlock. Do not "
            "start Chrome until this is resolved.")


def systemd_listen_socket(path=SOCK_PATH):
    """The listening socket systemd passed as fd 3 for path, or None."""
    if (os.environ.get("LISTEN_PID") != str(os.getpid())
            or os.environ.get("LISTEN_FDS") != "1"):
        return None
    for k in ("LISTEN_PID", "LISTEN_FDS", "LISTEN_FDNAMES"):
        os.environ.pop(k, None)
    srv = socket.socket(fileno=3)
    if srv.family != socket.AF_UNIX or srv.getsockname() != str(path):
        die(f"fd 3 is not {path}")
    return srv


# --------------------------------------------------------------------------
# client side
# --------------------------------------------------------------------------

def daemon_call(req, timeout=10.0):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(str(SOCK_PATH))
        s.sendall((json.dumps(req) + "\n").encode("utf-8"))
        data = b""
        while not data.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
        s.close()
        return json.loads(data.decode("utf-8") or "{}")
    except (FileNotFoundError, ConnectionRefusedError):
        return None
    except Exception:
        return None


def try_start_daemon():
    """The daemon is socket-activated by systemd: connecting starts it.
    Retry briefly in case it is (re)starting."""
    for _ in range(30):
        if daemon_call({"cmd": "ping"}, timeout=2) is not None:
            return True
        time.sleep(0.2)
    return False


def require_daemon():
    r = daemon_call({"cmd": "ping"})
    if r is None:
        try_start_daemon()
        r = daemon_call({"cmd": "ping"})
    if r is None:
        die("daemon is not running (try: sudo systemctl start mp35n.socket mp35n.service)")
    return r


def _fmt_uptime(sec):
    sec = int(sec)
    d, h, m = sec // 86400, sec % 86400 // 3600, sec % 3600 // 60
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m}m"
    return f"{m}m {sec % 60}s" if m else f"{sec}s"


def cmd_status(args):
    r = daemon_call({"cmd": "status"})
    if r is None:
        if try_start_daemon():
            r = daemon_call({"cmd": "status"})
    if r is None:
        print(f"{paint(APP, 'bold')}  {paint('daemon not running', 'red')}")
        return 2
    if not r.get("ok"):
        print(f"{paint(APP, 'bold')}  {paint(r.get('error'), 'red')}")
        return 2

    if not VAULT_PATH.exists():
        state = paint("no vault", "red")
    elif r["locked"]:
        state = paint("locked", "green")
    else:
        state = paint("unlocked", "yellow")
    print(f"{paint(APP, 'bold')}  {state}")
    print()

    status_row("daemon", f"up {_fmt_uptime(r['uptime'])}")
    if VAULT_PATH.exists():
        status_row("vault", paint("present", "green"), "~/.config/35vault.json")
    else:
        status_row("vault", paint("missing", "red"), "run '35 init'")
    if r.get("name_owned"):
        status_row("bus name", paint("owned", "green"), SERVICE_NAME)
    else:
        status_row("bus name", paint(f"held by {r.get('name_owner') or 'nobody'}", "red"))
        status_warn("unlock refused; do not start Chrome until this is resolved")

    chrome = r.get("chrome_path")
    trust = trusted_path(chrome) if chrome else "not installed"
    status_row("chrome", paint(chrome, "green") if chrome and not trust
               else paint(chrome or "not installed", "red"),
               "root-owned" if not trust else trust)
    if r.get("authorized_pid"):
        status_row("authorized", f"pid {r['authorized_pid']}")
    if r.get("last_portal"):
        lp = r["last_portal"]
        when = time.strftime("%H:%M:%S", time.localtime(lp.get("at", 0)))
        note = when + (f", others frozen {lp['frozen_ms']} ms"
                       if lp.get("frozen_ms") is not None else "")
        status_row("delivered", f"pid {lp.get('pid')}", note)
        if lp.get("warning"):
            status_warn(f"{lp['warning']}; rekey with '35 init --force' if unsure")
    if r.get("denied"):
        ld = r.get("last_denied") or {}
        status_row("denied", paint(f"{r['denied']} request(s)", "yellow"),
                   f"last: {ld.get('where')}")

    for db, counts in cookie_report():
        parts = Path(db).parts
        prof = parts[-2] if parts[-3] == "google-chrome" else f"{parts[-3]}/{parts[-2]}"
        tags = []
        for k, n in sorted(counts.items()):
            color = "green" if k == "v12" else "red" if k in ("v10", "plain", "error") else "yellow"
            tags.append(paint(f"{k} {n}", color))
        status_row("cookies", "  ".join(tags) or paint("empty", "dim"), prof)
        if counts.get("v10") or counts.get("plain"):
            status_warn("v10/plain cookies use the public 'peanuts' key; launch via "
                        "'35 run' and log in again to rewrite them as v12")

    print_chrome_policy_status()
    return 0 if not r["locked"] else 1


def cmd_unlock(args):
    require_daemon()
    if not VAULT_PATH.exists():
        die("no vault yet; run '35 init'")

    def verify(password):
        r = daemon_call({"cmd": "unlock", "password": password})
        if r is None:
            return False, "daemon is not running"
        return bool(r.get("ok")), r.get("error", "unlock failed")

    ok, why = prompt_unlock(verify)
    if not ok:
        die(why or "unlock failed")
    print(f"{APP}: unlocked (no Chrome is authorized; only '35 run' can "
          "authorize a launch, so this delivers the key to nobody)")
    return 0


