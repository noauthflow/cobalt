    class PortalSecret(dbus.service.Object):
        @dbus.service.method(IF_PORTAL_SECRET, in_signature="osha{sv}",
                             out_signature="ua{sv}", sender_keyword="sender",
                             async_callbacks=("reply", "_error"))
        def RetrieveSecret(self, _handle, app_id, fd, _options, sender=None,
                           reply=None, _error=None):
            guard_portal(sender)
            app = str(app_id)

            def refuse(why, ours):
                print(f"{APP}: portal call refused: {why}", flush=True)
                state.denied += 1
                state.last_denied = {"sender": "portal", "at": time.time(),
                                     "where": f"RetrieveSecret: {why}",
                                     "ours": ours}
                if ours:
                    state.wipe()  # Chrome itself was refused: lock
                reply(*portal_result(2))

            if app.lower() not in CHROME_APP_IDS:
                print(f"{APP}: portal deny app_id={app!r}", flush=True)
                state.denied += 1
                state.last_denied = {"sender": "portal", "at": time.time(),
                                     "where": f"RetrieveSecret: app_id {app!r}"}
                return reply(*portal_result(2))
            if state.secret is None:
                print(f"{APP}: portal request while locked", flush=True)
                state.denied += 1
                state.last_denied = {"sender": "portal", "at": time.time(),
                                     "where": "RetrieveSecret: vault locked"}
                return reply(*portal_result(2))

            raw = fd.take() if hasattr(fd, "take") else int(fd)
            if state.delivering:
                os.close(raw)
                return refuse("another delivery is in progress", False)
            g = state.grant
            if not g or not g.get("pid"):
                os.close(raw)
                return refuse("no Chrome launch authorized "
                              "(start Chrome with '35 run')", False)

            # Freeze everything else of ours before the key exists anywhere
            # outside this process.
            freezer = DeliveryFreeze(g["pid"], verifier._pid_for_sender(sender),
                                     g.get("scope"))
            import threading
            watchdog = threading.Timer(WATCHDOG, freezer.thaw)
            watchdog.daemon = True
            watchdog.start()
            state.delivering = True

            def finish(note=None):
                watchdog.cancel()
                try:
                    os.close(raw)
                except OSError:
                    pass
                errors = freezer.thaw()
                state.delivering = False
                if errors:
                    notify("mp35n could not thaw: " + "; ".join(errors))
                return note

            try:
                why = freezer.freeze()
                ours = True
                if not why:
                    why, ours = state.check_request(raw)
            except Exception as e:
                why, ours = f"verification error: {e}", True
            if why:
                finish()
                return refuse(why, ours)

            pid = g["pid"]
            frozen_ms = freezer.elapsed_ms()
            try:
                secret = bytes(state.secret)
                off = 0
                while off < len(secret):
                    n = os.write(raw, secret[off:])
                    if n <= 0:
                        raise OSError("short write")
                    off += n
            except Exception as e:
                print(f"{APP}: portal write failed: {e}", flush=True)
                finish()
                return reply(*portal_result(2))
            state.wipe()  # one key per unlock: lock immediately
            # Chrome reads the pipe once the portal relays this reply, so
            # answer now and keep everything else frozen until it has.
            reply(*portal_result(0))

            import fcntl
            import termios
            from gi.repository import GLib
            drain_deadline = time.monotonic() + DRAIN_TIMEOUT

            def poll_drain():
                buf = bytearray(4)
                try:
                    fcntl.ioctl(raw, termios.FIONREAD, buf)
                    left = struct.unpack("i", bytes(buf))[0]
                except OSError:
                    left = 0
                timed_out = time.monotonic() > drain_deadline
                if left and not timed_out:
                    return True  # poll again
                late = freezer.audit() if not left else None
                total = freezer.elapsed_ms()
                finish()
                warning = None
                if left:
                    warning = (f"Chrome did not read the key within "
                               f"{DRAIN_TIMEOUT:.0f}s; it was still in the pipe "
                               "when everything was thawed")
                elif late:
                    warning = f"process appeared during delivery: {late}"
                state.last_portal = {"app_id": app, "pid": pid, "at": time.time(),
                                     "frozen_ms": total, "warning": warning}
                if warning:
                    print(f"{APP}: WARNING {warning}", flush=True)
                    notify(f"mp35n: {warning}. Consider '35 init --force'.")
                print(f"{APP}: portal secret delivered to verified Chrome pid "
                      f"{pid} (app_id={app!r}); everything else frozen for "
                      f"{total} ms (audit took {frozen_ms} ms); vault locked",
                      flush=True)
                return False

            GLib.timeout_add(2, poll_drain)

        @dbus.service.method(IF_PROPS, in_signature="ss", out_signature="v",
                             sender_keyword="sender")
        def Get(self, interface, prop, sender=None):
            guard_portal(sender)
            if prop == "version":
                return dbus.UInt32(1)
            raise dbus.exceptions.DBusException(
                f"no such property {prop}",
                name="org.freedesktop.DBus.Error.InvalidArgs")

        @dbus.service.method(IF_PROPS, in_signature="s", out_signature="a{sv}",
                             sender_keyword="sender")
        def GetAll(self, interface, sender=None):
            guard_portal(sender)
            return {"version": dbus.UInt32(1)}

    return (
        SecretService(bus, SERVICE_PATH),
        Collection(bus, COLLECTION_PATH),
        Item(bus, ITEM_PATH),
        PortalSecret(bus, PORTAL_PATH),
    )


