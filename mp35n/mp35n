def ask_confirm(message, default=False):
    """Yes/no question via the terminal or GTK; never via a shell helper."""
    if sys.stdin.isatty() or STDIN_PASSWORD:
        suffix = " [Y/n] " if default else " [y/N] "
        try:
            answer = input(message + suffix).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return False
        if not answer:
            return default
        return answer in ("y", "yes")
    if not _gtk_ready():
        die("confirmation needs a terminal or a graphical display")
    return _gtk_confirm(message, default)


def prompt_new_password():
    """Ask for a new master password twice. Returns (password, error)."""
    if sys.stdin.isatty() or STDIN_PASSWORD:
        pw1 = getpass_password("New master password: ")
        if not pw1:
            return None, "empty password not allowed"
        pw2 = getpass_password("Repeat: ")
        if pw1 != pw2:
            return None, "passwords do not match"
        return pw1, None
    if not _gtk_ready():
        return None, "no graphical display; run from a terminal"
    try:
        pw = _gtk_new_password()
    except Exception as e:
        return None, f"GTK prompt failed: {e}"
    if pw is None:
        return None, "cancelled"
    return pw, None


def getpass_password(prompt):
    if STDIN_PASSWORD:
        line = sys.stdin.readline()
        if not line:
            return None
        return line.rstrip("\n")
    import getpass
    try:
        return getpass.getpass(prompt)
    except (EOFError, KeyboardInterrupt):
        print()
        return None


def prompt_unlock(verify):
    """Ask for the master password via the terminal or native GTK.
    verify(password) -> (ok, error). Returns (ok, error)."""
    if sys.stdin.isatty() or STDIN_PASSWORD:
        err = None
        for attempt in range(3):
            prompt = "Master password:"
            if err:
                prompt = f"{err} — try again ({attempt + 1}/3):"
            password = getpass_password(prompt)
            if password is None:
                return False, "no password entered"
            ok, why = verify(password)
            if ok:
                return True, None
            err = why
            if "too many attempts" in (err or ""):
                return False, err
            print(f"{APP}: {err} (attempt {attempt + 1}/3)", file=sys.stderr)
        return False, err or "unlock failed"

    if not _gtk_ready():
        return False, "no graphical display; run from a terminal"
    try:
        return _gtk_unlock(verify)
    except Exception as e:
        return False, f"GTK prompt failed: {e}"


def cmd_lock(args):
    r = daemon_call({"cmd": "lock"})
    if r is None:
        if try_start_daemon():
            r = daemon_call({"cmd": "lock"})
    if r is None:
        die("daemon is not running")
    if not r.get("ok"):
        die(r.get("error", "lock failed"))
    print(f"{APP}: locked")
    return 0


def cmd_run(args):
    """Re-pin if Chrome changed, unlock, launch Chrome, confirm the key was
    delivered to the verified binary, then lock the vault again. Works from
    a terminal or a .desktop entry."""
    if not VAULT_PATH.exists():
        chrome = find_chrome()
        if not chrome:
            die("no vault and no chrome binary found")
        os.execvp(chrome, [chrome] + list(args))  # nothing to protect

    require_daemon()
    try:
        pin = load_pin()
    except Exception:
        die("no pin; run '35 init' or '35 trust' first")
    chrome = pin.get("chrome_path")
    if not chrome or not os.path.isfile(chrome):
        die(f"pinned chrome binary missing: {chrome!r}")
    st = os.stat(chrome)
    if st.st_uid != 0 or (st.st_mode & stat.S_IWOTH):
        die("pinned chrome binary is not root-owned or is world-writable; refusing")

    digest = sha256_file(chrome)
    if digest != pin.get("chrome_sha256"):
        # This launch IS the trust decision: hash the exact root-owned
        # binary about to run. Must happen before the unlock so the secret
        # is never spent on a launch that would be denied.
        write_private(PIN_PATH, json.dumps({
            "chrome_path": chrome,
            "chrome_sha256": digest,
            "created": int(time.time()),
        }, indent=2).encode("utf-8") + b"\n")
        notify(f"chrome binary changed; re-pinned {digest[:16]}...")

    started = int(time.time())
    st0 = daemon_call({"cmd": "status"}) or {}
    if st0.get("locked"):
        def verify(pw):
            ur = daemon_call({"cmd": "unlock", "password": pw})
            if ur is None:
                return False, "daemon is not running"
            return bool(ur.get("ok")), ur.get("error", "unlock failed")

        ok, why = prompt_unlock(verify)
        if not ok:
            die(f"{why or 'unlock failed'}; not starting chrome")

    proc = subprocess.Popen(
        [chrome] + list(args),
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True)

    delivered = False
    deadline = time.time() + 20
    while time.time() < deadline:
        st2 = daemon_call({"cmd": "status"}) or {}
        ld = st2.get("last_delivered")
        if ld and ld.get("at", 0) >= started:
            delivered = True
            break
        if proc.poll() is not None:
            break  # existing instance took over, or a --version-style call
        time.sleep(0.2)

    daemon_call({"cmd": "lock"})
    if delivered:
        notify("key delivered to chrome; vault locked again")
    elif proc.poll() is not None:
        pass  # exited without asking for the key; already locked
    else:
        # Chrome is running but never asked for the key. Locking now would
        # silently push it to v10 and destroy cookies, so stay unlocked.
        notify("key NOT confirmed delivered - vault stays UNLOCKED. "
               "run '35 lock' once chrome is up")
    return 0


def cmd_init(args):
    ensure_dir()
    if VAULT_PATH.exists() and "--force" not in args:
        die("vault already exists (use --force to wipe it)")

    chrome = find_chrome()
    if not chrome:
        die("could not find a Chrome/Chromium binary; pass one in config manually")
    digest = sha256_file(chrome)

    print(f"{APP}: Chrome binary")
    print(f"  path:   {chrome}")
    print(f"  sha256: {digest}")
    if not ask_confirm("Pin this binary as the only allowed caller?", default=True):
        die("aborted")

    pw1, why = prompt_new_password()
    if pw1 is None:
        die(why or "no password entered")
    if len(pw1) < 8:
        print(f"{APP}: warning: password shorter than 8 characters", file=sys.stderr)

    secret = os.urandom(SECRET_LEN)
    vault = vault_encrypt(pw1, secret)
    write_private(VAULT_PATH, json.dumps(vault, indent=2).encode("utf-8") + b"\n")
    write_private(PIN_PATH, json.dumps({
        "chrome_path": chrome,
        "chrome_sha256": digest,
        "created": int(time.time()),
    }, indent=2).encode("utf-8") + b"\n")

    print(f"{APP}: vault created at {VAULT_PATH}")
    print(f"{APP}: codeword: {vault_phrase()}")
    print(f"{APP}: Chrome pinned")
    print(f"{APP}: next: './install.sh' then '35 unlock'")
    return 0


def cmd_trust(args):
    chrome = find_chrome()
    if not chrome:
        die("could not find a Chrome/Chromium binary")
    digest = sha256_file(chrome)
    old = {}
    try:
        old = load_pin()
    except Exception:
        pass
    print(f"{APP}: Chrome binary: {chrome}")
    print(f"  current pin: {old.get('chrome_sha256', '(none)')[:16]}...")
    print(f"  new sha256:  {digest[:16]}...")
    if not ask_confirm("Trust this binary now?", default=False):
        die("aborted")
    ensure_dir()
    write_private(PIN_PATH, json.dumps({
        "chrome_path": chrome,
        "chrome_sha256": digest,
        "created": int(time.time()),
    }, indent=2).encode("utf-8") + b"\n")
    print(f"{APP}: re-pinned")
    return 0


USAGE = __doc__.strip()


def main(argv):
    global STDIN_PASSWORD
    if "--password-stdin" in argv:
        STDIN_PASSWORD = True
        argv = [a for a in argv if a != "--password-stdin"]
    if not argv:
        return cmd_status([])

    cmd, args = argv[0], argv[1:]
    if cmd in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    table = {
        "unlock": cmd_unlock,
        "lock": cmd_lock,
        "run": cmd_run,
        "status": cmd_status,
        "init": cmd_init,
        "trust": cmd_trust,
        "daemon": cmd_daemon,
    }
    fn = table.get(cmd)
    if not fn:
        print(USAGE)
        return 2
    return fn(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
