def notify(msg):
    """Show a message in whatever session we are in (stderr + desktop
    notification). Harmless when no notification daemon is running."""
    print(f"{APP}: {msg}", file=sys.stderr, flush=True)
    try:
        subprocess.run(["notify-send", "-a", APP, "mp35n", msg],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=5)
    except Exception:
