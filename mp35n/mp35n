def _gtk_unlock(verify):
    """Native GTK4/libadwaita unlock dialog. It stays open on a wrong
    password, shows the daemon error inline, and runs the daemon call off
    the UI thread. Returns (ok, error)."""
    import threading
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Gtk, Adw, GLib

    result = {"ok": False, "error": None}
    state = {"busy": False, "closed": False}
    loop = GLib.MainLoop()

    body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    body.set_margin_top(24)
    body.set_margin_bottom(24)
    body.set_margin_start(24)
    body.set_margin_end(24)

    phrase_label = Gtk.Label(label=vault_phrase())
    phrase_label.add_css_class("title-1")
    phrase_label.set_halign(Gtk.Align.START)
    phrase_label.set_selectable(False)
    body.append(phrase_label)

    hint = Gtk.Label(label="Check the phrase before typing your master password.")
    hint.add_css_class("dim-label")
    hint.set_halign(Gtk.Align.START)
    hint.set_wrap(True)
    hint.set_xalign(0)
    body.append(hint)

    entry = Gtk.PasswordEntry()
    entry.set_show_peek_icon(False)
    entry.set_property("placeholder-text", "Master password")
    entry.set_hexpand(True)
    body.append(entry)

    error_revealer = Gtk.Revealer()
    error_revealer.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN)
    error_label = Gtk.Label()
    error_label.set_halign(Gtk.Align.START)
    error_label.set_wrap(True)
    error_label.set_xalign(0)
    error_revealer.set_child(error_label)
    body.append(error_revealer)

    status = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    status.set_visible(False)
    spinner = Gtk.Spinner()
    status_label = Gtk.Label()
    status_label.add_css_class("dim-label")
    status.append(spinner)
    status.append(status_label)
    body.append(status)

    header = Adw.HeaderBar()
    header.set_show_start_title_buttons(False)
    header.set_show_end_title_buttons(False)
    header.set_title_widget(Gtk.Box())
    cancel_btn = Gtk.Button(label="Cancel")
    unlock_btn = Gtk.Button(label="Unlock")
    unlock_btn.add_css_class("suggested-action")
    header.pack_start(cancel_btn)
    header.pack_end(unlock_btn)
    win = _gtk_shell(APP, body, header)
    win.set_default_widget(unlock_btn)

    def clear_error(*_):
        error_revealer.set_reveal_child(False)

    def show_error(text):
        error_label.set_markup(
            "<span foreground='#e01b24'>"
            + GLib.markup_escape_text(text)
            + "</span>")
        error_revealer.set_reveal_child(True)

    entry.connect("changed", clear_error)

    def finish(ok, why):
        if state["closed"]:
            return False
        state["busy"] = False
        spinner.stop()
        status.set_visible(False)
        status_label.set_text("")
        unlock_btn.set_sensitive(True)
        entry.set_sensitive(True)
        if ok:
            result["ok"] = True
            state["closed"] = True
            win.destroy()
            loop.quit()
        else:
            show_error(why or "unlock failed")
            entry.grab_focus()
        return False

    def submit(*_):
        if state["busy"] or state["closed"]:
            return
        pw = entry.get_text()
        if not pw:
            show_error("Enter the master password.")
            return
        entry.set_text("")
        clear_error()
        state["busy"] = True
        unlock_btn.set_sensitive(False)
        entry.set_sensitive(False)
        status.set_visible(True)
        spinner.start()
        status_label.set_text("Unlocking…")

        def worker():
            try:
                ok, why = verify(pw)
            except Exception as e:
                ok, why = False, str(e)
            GLib.idle_add(finish, ok, why)

        threading.Thread(target=worker, daemon=True).start()

    def cancel(*_):
        if state["closed"]:
            return
        state["closed"] = True
        result["error"] = "cancelled"
        win.destroy()
        loop.quit()

    def on_close(*_):
        cancel()
        return True

    entry.connect("activate", submit)
    cancel_btn.connect("clicked", cancel)
    unlock_btn.connect("clicked", submit)
    win.connect("close-request", on_close)
    _bind_escape(win, cancel)
    win.present()
    entry.grab_focus()
    loop.run()
    return result["ok"], result["error"]


