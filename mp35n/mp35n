    dlg.add_response("no", "No")
    dlg.add_response("yes", "Yes")
    dlg.set_default_response("yes" if default else "no")
    dlg.set_close_response("no")

    result = {"yes": False}
    loop = GLib.MainLoop()

    def done(source, res):
        try:
            response = source.choose_finish(res)
        except Exception:
            response = "no"
        result["yes"] = response == "yes"
        loop.quit()

    dlg.choose(None, None, done)
    loop.run()
    return result["yes"]


