# daemon state
# --------------------------------------------------------------------------

class State:
    def __init__(self):
        self.secret = None          # bytearray while unlocked
        self.denied = 0
        self.last_denied = None
        self.last_portal = None     # {app_id, at} after a portal delivery
        self.fail_count = 0
        self.fail_until = 0.0
        self.name_owned = False
        self.name_owner = None      # "pid:exe" of a squatter holding the name
        self.started = time.time()
        self.srv = None
        # One launch authorization per unlock: {"token": str, "pid": int|None}.
        # The token goes only to the client that typed the password; it
        # binds that unlock to the one Chrome process `35 run` started.
        self.grant = None
        self.delivering = False     # a DeliveryFreeze is active

    @property
    def locked(self):
        return self.secret is None

    def wipe(self):
        if self.secret is not None:
            for i in range(len(self.secret)):
                self.secret[i] = 0
        self.secret = None
        self.grant = None

    def check_request(self, raw_fd):
        """(None, True) if the key may be written into raw_fd; else
        (reason, ours). ours=True means the request came from the authorized
        Chrome (it holds the read end), so Chrome itself was refused;
        ours=False means some other process asked and was turned away."""
        g = self.grant
        readers, hidden = pipe_readers(raw_fd)
        who = ", ".join(describe_pid(p) for p in sorted(readers)) or "nobody"
        if not g or not g.get("pid"):
            return (f"no Chrome launch authorized (start Chrome with '35 run'); "
                    f"requester [{who}]"), False
        pid = g["pid"]
        if pid not in readers:
            return f"request from [{who}], not from authorized Chrome pid {pid}", False
        if readers != {pid}:
            return (f"Chrome's pipe is ALSO open in [{who}]: another process "
                    f"is trying to read the key"), True
        why = verify_chrome_process(pid)
        if why:
            return f"authorized Chrome pid {pid} failed verification: {why}", True
        if hidden:
            print(f"{APP}: note: uninspectable same-uid processes: "
                  + ", ".join(describe_pid(p) for p in hidden), flush=True)
        return None, True

    def handle_control(self, req):
        cmd = req.get("cmd")
        if cmd == "ping":
            return {"ok": True}
        if cmd == "status":
            return {
                "ok": True,
                "locked": self.locked,
                "name_owned": self.name_owned,
                "name_owner": self.name_owner,
                "denied": self.denied,
                "last_denied": self.last_denied,
                "last_portal": self.last_portal,
                "uptime": int(time.time() - self.started),
                "chrome_path": find_chrome(),
                "authorized_pid": (self.grant or {}).get("pid"),
                "vault": "ok" if VAULT_PATH.exists() else "missing",
            }
        if cmd == "unlock":
            if not self.name_owned:
                return {"ok": False, "error": name_squat_message(self.name_owner)}
            if not VAULT_PATH.exists():
                return {"ok": False, "error": "no vault yet; run '35 init'"}
            if time.time() < self.fail_until:
                return {"ok": False, "error": "too many attempts; wait a moment"}
            try:
                secret = unseal(json.loads(VAULT_PATH.read_text()),
                                req.get("password", ""))
            except Exception:
                self.fail_count += 1
                # No delay for the first two typos; then back off.
                delay = 0 if self.fail_count <= 2 else min(
                    2 ** (self.fail_count - 2), 15)
                self.fail_until = time.time() + delay
                return {"ok": False, "error": "wrong master password"}
            self.fail_count, self.fail_until = 0, 0.0
            self.wipe()
            self.secret = bytearray(secret)
            import secrets
            self.grant = {"token": secrets.token_hex(32), "pid": None}
            return {"ok": True, "token": self.grant["token"]}
        if cmd == "authorize":
            g = self.grant
            token = str(req.get("token", "")).encode()
            if not g or not hmac.compare_digest(token, g["token"].encode()):
                return {"ok": False, "error": "bad or expired launch token"}
            if g.get("pid"):
                return {"ok": False, "error": "a launch is already authorized"}
            try:
                pid = int(req.get("pid"))
            except (TypeError, ValueError):
                return {"ok": False, "error": "bad pid"}
            why = verify_chrome_process(pid)
            if why:
                return {"ok": False, "error": why}
            scope = str(req.get("scope", ""))
            launch = f"{user_manager_cg()}/app.slice/{scope}"
            own = (f"{user_manager_cg()}/app.slice/"
                   f"{CHROME_OWN_SCOPE.format(pid=pid)}")
            if (not scope.startswith(CHROME_SCOPE_PREFIX)
                    or not scope.endswith(".scope") or "/" in scope):
                return {"ok": False, "error": f"bad launch scope {scope!r}"}
            try:
                cg = proc_cgroup(pid)
            except OSError as e:
                return {"ok": False, "error": f"cannot read Chrome's cgroup: {e}"}
            if cg not in (launch, own):
                return {"ok": False, "error": f"Chrome runs in {cg}, not {launch}"}
            g["scope"] = launch
            g["pid"] = pid
            print(f"{APP}: authorized Chrome pid {pid} in {g['scope']}", flush=True)
            return {"ok": True}
        if cmd == "lock":
            self.wipe()
            return {"ok": True}
        return {"ok": False, "error": f"unknown command {cmd!r}"}


# --------------------------------------------------------------------------
# dbus service objects
# --------------------------------------------------------------------------

def build_dbus_objects(bus, state, verifier):
    import dbus
    import dbus.service

    def guard(sender, who):
        if not verifier.is_chrome(sender):
            state.denied += 1
            state.last_denied = {"sender": str(sender), "at": time.time(), "where": who}
            raise dbus.exceptions.DBusException(
                "caller is not verified Chrome",
                name="org.freedesktop.DBus.Error.AccessDenied")

    def deny_portal(msg):
        # Make portal refusals loud: a refused RetrieveSecret silently pushes
        # Chrome to v10 cookies.
        print(f"{APP}: portal call refused: {msg}", flush=True)
        state.denied += 1
        state.last_denied = {"sender": "portal", "at": time.time(),
                             "where": f"RetrieveSecret: {msg}"}
        raise dbus.exceptions.DBusException(
            msg, name="org.freedesktop.DBus.Error.AccessDenied")

    def portal_result(code):
        return (dbus.UInt32(code), dbus.Dictionary({}, signature="sv"))

    def guard_portal(sender):
        # The portal frontend is the only thing allowed to call the Secret
        # backend interface. Verify that it owns the portal name and that
        # the process lives in the xdg-desktop-portal.service cgroup.
        if not sender:
            deny_portal("no sender")
        try:
            owner = verifier._connection().call_blocking(
                "org.freedesktop.DBus", "/org/freedesktop/DBus",
                "org.freedesktop.DBus", "GetNameOwner", "s",
                ("org.freedesktop.portal.Desktop",))
            owner = str(owner)
        except Exception:
            deny_portal("portal is not running")
        if owner != str(sender):
            deny_portal("caller is not the portal")

        pid = verifier._pid_for_sender(sender)
        if pid is None:
            deny_portal("cannot resolve portal pid")
        try:
            with open(f"/proc/{pid}/cgroup") as f:
                cgroups = [line.rstrip("\n").split(":", 2)[-1] for line in f]
        except OSError as e:
            deny_portal(f"cannot read portal cgroup: {e}")
        if not any(cg.endswith("/" + PORTAL_UNIT) for cg in cgroups):
            deny_portal(f"portal not in {PORTAL_UNIT}: {cgroups!r}")
        try:
            exe = os.readlink(f"/proc/{pid}/exe")
        except OSError as e:
            deny_portal(f"cannot read portal exe: {e}")
        if exe not in PORTAL_BINARIES:
            deny_portal(f"unexpected portal binary {exe!r}")
        why = trusted_path(exe)
        if why:
            deny_portal(f"untrusted portal binary: {why}")

    class SecretService(dbus.service.Object):
        @dbus.service.method(IF_SERVICE, in_signature="s", out_signature="o",
                             sender_keyword="sender")
        def ReadAlias(self, name, sender=None):
            guard(sender, "ReadAlias")
            return dbus.ObjectPath(COLLECTION_PATH)

        @dbus.service.method(IF_SERVICE, in_signature="sv", out_signature="vo",
                             sender_keyword="sender")
        def OpenSession(self, _algorithm, _input, sender=None):
            guard(sender, "OpenSession")
            print(f"{APP}: refusing secret-service session", flush=True)
            raise dbus.exceptions.DBusException(
                "use the desktop portal",
                name="org.freedesktop.DBus.Error.NotSupported")

        @dbus.service.method(IF_SERVICE, in_signature="ao", out_signature="aoo",
                             sender_keyword="sender")
        def Unlock(self, objects, sender=None):
            guard(sender, "Unlock")
            return (objects, dbus.ObjectPath("/"))

        @dbus.service.method(IF_SERVICE, in_signature="ao", out_signature="aoo",
                             sender_keyword="sender")
        def Lock(self, objects, sender=None):
            guard(sender, "Lock")
            return (objects, dbus.ObjectPath("/"))

        @dbus.service.method(IF_SERVICE, in_signature="a{ss}", out_signature="aoo",
                             sender_keyword="sender")
        def SearchItems(self, attributes, sender=None):
            guard(sender, "SearchItems(service)")
            return ([dbus.ObjectPath(ITEM_PATH)], [])

        @dbus.service.method(IF_SERVICE, in_signature="a{sv}s", out_signature="oo",
                             sender_keyword="sender")
        def CreateCollection(self, properties, alias, sender=None):
            guard(sender, "CreateCollection")
            return (dbus.ObjectPath(COLLECTION_PATH), dbus.ObjectPath("/"))

    class Collection(dbus.service.Object):
        @dbus.service.method(IF_COLLECTION, in_signature="a{ss}", out_signature="aoo",
                             sender_keyword="sender")
        def SearchItems(self, attributes, sender=None):
            guard(sender, "SearchItems")
            return ([dbus.ObjectPath(ITEM_PATH)], [])

        @dbus.service.method(IF_COLLECTION, in_signature="a{sv}(oayays)b",
                             out_signature="oo", sender_keyword="sender")
