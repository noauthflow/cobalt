{
  "name": "cobalt",
  "version": "1.0",
  "description": "Blank new tab page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "manifest_version": 3,
  "chrome_url_overrides": { "newtab": "blank.html" },
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "css": ["hide.css"],
    "js": ["block.js"],
    "run_at": "document_start"
  }]
}
