{
  "name": "cobalt",
  "version": "1.1",
  "description": "Blank new tab page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "manifest_version": 3,
  "permissions": ["storage", "unlimitedStorage"],
  "background": { "service_worker": "pin.js" },
  "commands": {
    "pin-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Pin or unpin the current tab"
    }
  },
  "chrome_url_overrides": { "newtab": "blank.html" },
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "css": ["hide.css"],
    "js": ["block.js"],
    "run_at": "document_start"
  }]
}
