def profile_kind(d):
    if os.path.exists(os.path.join(d, "Web Data")) or os.path.exists(os.path.join(d, "Bookmarks")):
        return "chromium"
    if os.path.exists(os.path.join(d, "places.sqlite")):
        return "firefox"
    return None

def find_profiles(root):
    profiles = []
    if not os.path.isdir(root):
        return profiles

    if profile_kind(root):
        profiles.append(root)

    search_dirs = [root] + [os.path.join(root, n) for n in sorted(os.listdir(root))
                            if os.path.isdir(os.path.join(root, n))]
    for d in search_dirs:
        if d != root and profile_kind(d) and d not in profiles:
            profiles.append(d)
        for name in sorted(os.listdir(d)):
            sub = os.path.join(d, name)
            if os.path.isdir(sub) and profile_kind(sub) and sub not in profiles:
                profiles.append(sub)
    return profiles

def resolve_target(args):
    if args.root:
        root = os.path.abspath(os.path.expanduser(args.root))
        if not os.path.isdir(root):
            sys.exit(f"error: --root {root} does not exist")
    else:
        root = browser_roots().get(args.browser)
        if not root or not os.path.isdir(root):
            sys.exit(f"error: browser '{args.browser}' not found. Try `list`, or pass --root.")
    profiles = find_profiles(root)
    names = [os.path.basename(p) for p in profiles]

    if args.profile:

        low = args.profile.lower()
        for candidates in (
                [p for p in profiles if os.path.basename(p) == args.profile],
                [p for p in profiles if os.path.basename(p).lower() == low],
                [p for p in profiles if low in os.path.basename(p).lower()]):
            if len(candidates) == 1:
                return root, candidates
            if len(candidates) > 1:
                sys.exit(f"error: --profile '{args.profile}' matches several profiles: "
                         f"{', '.join(os.path.basename(c) for c in candidates)}")
        sys.exit(f"error: profile '{args.profile}' not found under {root}\n"
                 f"       profiles: {', '.join(names)}")

    if not profiles:
        sys.exit(f"error: no profiles found under {root}")
    if len(profiles) > 1 and not getattr(args, "all_profiles", False):
        sys.exit(f"error: multiple profiles found: {', '.join(names)}\n"
                 f"       pass --profile <name> to pick one, or --all for every profile")
    return root, profiles

def favicon_for(url):
    p = urlparse(url if "//" in url else "https://" + url)
    if p.scheme in ("http", "https") and p.netloc:
        return f"{p.scheme}://{p.netloc}/favicon.ico"
    return ""

def parse_config(path):
    tree, engines = [], []
    stack = [(-1, tree)]
    with open(path, encoding="utf-8") as f:
        for n, raw in enumerate(f, 1):
            line = raw.rstrip("\n")
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            indent = len(line) - len(line.lstrip(" \t"))
            if "\t" in line[:indent + 1]:
                indent = line[:indent + 1].count("\t") * 4
            while stack[-1][0] >= indent:
                stack.pop()
            parent = stack[-1][1]

            if stripped.startswith("[") and stripped.endswith("]"):
                name = stripped[1:-1].strip()
                if not name:
                    sys.exit(f"config error, line {n}: empty folder name")
                node = {"type": "folder", "name": name, "children": []}
                parent.append(node)
                stack.append((indent, node["children"]))
                continue

            parts = [p.strip() for p in stripped.split("|")]

            if len(parts) >= 3 and re.match(r"^[a-zA-Z][a-zA-Z0-9+.\-]*:", parts[1]):
                parts = [parts[0], "|".join(parts[1:])]

            if len(parts) == 1 and "=" in stripped:
                kw, url = (s.strip() for s in stripped.split("=", 1))
                if not kw or not url:
                    sys.exit(f"config error, line {n}: expected `keyword = url`, got:\n  {stripped}")
                engines.append(make_engine(kw, kw, url, n))
                continue

            if len(parts) == 2:
                name, keyword, url = parts[0], None, parts[1]
            elif len(parts) >= 3:
                name, keyword, url = parts[0], parts[1], "|".join(parts[2:])
            else:
                sys.exit(f"config error, line {n}: expected `Name | url` or "
                         f"`Name | keyword | url`, got:\n  {stripped}")
            if not url:
                sys.exit(f"config error, line {n}: missing url")

            if keyword:
                if "|" in keyword:
                    sys.exit(f"config error, line {n}: keyword must not contain '|'")
                engines.append(make_engine(name, keyword, url, n))
            else:
                if "|" in name:
                    sys.exit(f"config error, line {n}: bookmark name contains '|' — rename it")
                parent.append({"type": "url", "name": name, "url": url})
    return tree, engines

def make_engine(name, keyword, url, line_no):
    url = re.sub(r"\{query\}", "%s", url, flags=re.I)
    if "//" not in url:
        url = "https://" + url
    return {"name": name, "keyword": keyword, "url": url, "favicon_url": favicon_for(url)}

def serialize(tree):
    lines = []
    def walk(children, depth):
        for n in children:
            pad = "  " * depth
            if n["type"] == "folder":
                lines.append(f"{pad}[{n['name']}]")
                walk(n["children"], depth + 1)
            else:
                lines.append(f"{pad}{n['name']} | {n['url']}")
    walk(tree, 0)
    return lines

def webkit_now():
    return int((time.time() + 11644473600) * 1_000_000)

def push_engines(profile, engines, prune, dry):
    path = os.path.join(profile, "Web Data")
    try:
        con = sqlite3.connect(path)
    except sqlite3.OperationalError as e:
        sys.exit(f"error: cannot open {path} ({e}) — is the browser running? Close it and retry")
    actions = []
    try:
        cols = {row[1] for row in con.execute("PRAGMA table_info(keywords)")}
        if "keyword" not in cols:
            sys.exit(f"error: {path} has no `keywords` table — open the browser once, then retry")

        now = webkit_now()
        for e in engines:
            values = {
                "short_name": e["name"],
                "keyword": e["keyword"],
                "favicon_url": e["favicon_url"],

                "url": e["url"].replace("%s", "{searchTerms}"),
                "safe_for_autoreplace": 0,
                "input_encodings": "UTF-8",
                "suggest_url": "",
                "alternate_urls": "[]",
                "date_created": now,
                "last_modified": now,
                "sync_guid": GUID_PREFIX + str(uuid.uuid4()),
                "is_active": 1,
            }
            use = {k: v for k, v in values.items() if k in cols}
            row = con.execute("SELECT id, short_name, url FROM keywords WHERE keyword = ?",
                              (e["keyword"],)).fetchone()
            if row and row[1] == e["name"] and row[2] == use["url"]:
                actions.append(("=", e["keyword"], e["url"]))
                continue
            if row:
                sets = ", ".join(f"{k} = ?" for k in use if k != "keyword")
                con.execute(f"UPDATE keywords SET {sets} WHERE id = ?",
                            [v for k, v in use.items() if k != "keyword"] + [row[0]])
                actions.append(("~", e["keyword"], e["url"]))
            else:
                keys, qs = ", ".join(use), ", ".join("?" for _ in use)
                con.execute(f"INSERT INTO keywords ({keys}) VALUES ({qs})", list(use.values()))
                actions.append(("+", e["keyword"], e["url"]))

        if prune:
            keep = {e["keyword"] for e in engines}
            for (kw,) in con.execute("SELECT keyword FROM keywords WHERE sync_guid LIKE ?",
                                     (GUID_PREFIX + "%",)).fetchall():
                if kw not in keep:
                    con.execute("DELETE FROM keywords WHERE keyword = ?", (kw,))
                    actions.append(("-", kw, ""))

        if dry:
            con.rollback()
        else:
            con.commit()
        return actions
    except sqlite3.OperationalError as e:
        sys.exit(f"error: {path} is locked ({e}) — close the browser and retry")
    finally:
        con.close()

def pull_engines(profile):
    path = os.path.join(profile, "Web Data")
    if not os.path.exists(path):
        return []

    tmp = tempfile.mktemp(prefix="cobalt-webdata-")
    shutil.copy2(path, tmp)
    con = sqlite3.connect(tmp)
    try:
        cols = {row[1] for row in con.execute("PRAGMA table_info(keywords)")}
        if "keyword" not in cols:
            return []
        conds = ["prepopulate_id = 0", "keyword NOT LIKE '@%'"]
        if "starter_pack_id" in cols:
            conds.append("starter_pack_id = 0")
        where = "WHERE " + " AND ".join(conds)
        rows = con.execute(
            f"SELECT short_name, keyword, url FROM keywords {where} ORDER BY keyword").fetchall()
        return [{"name": r[0], "keyword": r[1],
                 "url": r[2].replace("{searchTerms}", "%s")}
                for r in rows if r[1] and r[2]]
    finally:
        con.close()
        os.remove(tmp)

def skeleton_bookmarks():
    now = str(webkit_now())
    def folder(i, name):
        return {"children": [], "date_added": now, "date_last_used": "0",
                "date_modified": now, "guid": str(uuid.uuid4()), "id": str(i),
                "name": name, "type": "folder"}
    return {"roots": {"bookmark_bar": folder(1, "Bookmarks bar"),
                      "other": folder(2, "Other bookmarks"),
                      "synced": folder(3, "Mobile bookmarks")}, "version": 1}

def walk_ids(node, acc):
    if isinstance(node, dict):
        try:
            acc.append(int(node["id"]))
        except (KeyError, TypeError, ValueError):
            pass
        for v in node.values():
            walk_ids(v, acc)

def count_urls(node):
    if node.get("type") == "url":
        return 1
    return sum(count_urls(c) for c in node.get("children", []) if isinstance(c, dict))

def push_bookmarks(profile, tree, dry):
    path = os.path.join(profile, "Bookmarks")
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    else:
        data = skeleton_bookmarks()
    try:
        bar = data["roots"]["bookmark_bar"]
    except KeyError:
        sys.exit(f"error: {path} has unexpected structure, aborting")
    bar.setdefault("children", [])

    ids = []
    walk_ids(data, ids)
    counter = max(ids or [0]) + 1
    created, renamed, removed = [], [], []

    def sync(existing, wanted):
        nonlocal counter, created
        available = list(existing)
        result = []
        for w in wanted:
            if w["type"] == "folder":
                m = next((c for c in available if isinstance(c, dict)
                          and c.get("type") == "folder" and c.get("name") == w["name"]), None)
                if m is None:
                    m = {"type": "folder", "name": w["name"], "guid": str(uuid.uuid4()),
                         "id": str(counter), "children": [],
                         "date_added": str(webkit_now()), "date_last_used": "0",
                         "date_modified": str(webkit_now())}
                    counter += 1
                    created.append(m)
                else:
                    available.remove(m)
                m["children"] = sync(m.get("children") or [], w["children"])
            else:
                m = next((c for c in available if isinstance(c, dict)
                          and c.get("type") == "url" and c.get("url") == w["url"]), None)
                if m is None:
                    m = {"type": "url", "name": w["name"], "url": w["url"],
                         "guid": str(uuid.uuid4()), "id": str(counter),
                         "date_added": str(webkit_now()), "date_last_used": "0"}
                    counter += 1
                    created.append(m)
                else:
                    available.remove(m)
                if m.get("name") != w["name"]:
                    renamed.append((m.get("name", "?"), w["name"]))
                    m["name"] = w["name"]
            result.append(m)
        removed.extend(available)
        return result

    bar["children"] = sync(bar["children"], tree)
    data.pop("checksum", None)
    if not dry:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=3, ensure_ascii=False)
    return created, renamed, removed

def pull_bookmarks(profile):
    path = os.path.join(profile, "Bookmarks")
    if not os.path.exists(path):
        return []
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    bar = data.get("roots", {}).get("bookmark_bar", {})

    def convert(children):
        out = []
        for c in children or []:
            if c.get("type") == "folder":
                out.append({"type": "folder", "name": c.get("name", ""),
                            "children": convert(c.get("children"))})
            elif c.get("type") == "url":
                out.append({"type": "url", "name": c.get("name", ""), "url": c.get("url", "")})
        return out

    return convert(bar.get("children"))

FF_BAR_GUID = "toolbar_____"

def ff_now():
    return int(time.time() * 1_000_000)

def ff_guid():
    return uuid.uuid4().hex[:12]

def ff_cols(con, table):
    return {row[1] for row in con.execute(f"PRAGMA table_info({table})")}

def ff_snapshot(profile):
    src = os.path.join(profile, "places.sqlite")
    tmp = tempfile.mktemp(prefix="cobalt-places-")
    shutil.copy2(src, tmp)
    for ext in ("-wal", "-shm"):
        if os.path.exists(src + ext):
            shutil.copy2(src + ext, tmp + ext)
    return tmp

def ff_cleanup(tmp):
    for f in (tmp, tmp + "-wal", tmp + "-shm"):
        if os.path.exists(f):
            os.remove(f)

def ff_insert_place(con, pcols, url, title):
    cols, vals = ["url", "title", "guid", "foreign_count"], [url, title, ff_guid(), 1]
    if "rev_host" in pcols:
        host = urlparse(url).netloc
        cols.append("rev_host")
        vals.append(host[::-1] + "." if host else None)
    if "url_hash" in pcols:
        cols.append("url_hash")
        vals.append(0)
    if "frecency" in pcols:
        cols.append("frecency")
        vals.append(-1)
    cur = con.execute(f"INSERT INTO moz_places ({', '.join(cols)}) "
                      f"VALUES ({', '.join('?' * len(cols))})", vals)
    return cur.lastrowid

def push_engines_ff(profile, engines, prune, dry):
    path = os.path.join(profile, "places.sqlite")
    try:
        con = sqlite3.connect(path)
    except sqlite3.OperationalError as e:
        sys.exit(f"error: cannot open {path} ({e}) — is the browser running? Close it and retry")
    actions = []
    try:
        pcols = ff_cols(con, "moz_places")
        bcols = ff_cols(con, "moz_bookmarks")
        if "keyword" not in ff_cols(con, "moz_keywords"):
            sys.exit(f"error: {path} has no `moz_keywords` table — open the browser once, then retry")

        menu = con.execute("SELECT id FROM moz_bookmarks WHERE guid = 'menu________'").fetchone()
        engine_folder = None
        if menu:
            engine_folder = con.execute(
                "SELECT id FROM moz_bookmarks WHERE parent = ? AND type = 2 AND title = 'Cobalt Engines'",
                (menu[0],)).fetchone()
            if engine_folder is None:
                now = ff_now()
                cols = ["type", "parent", "position", "title", "dateAdded", "lastModified", "guid"]
                vals = [2, menu[0], 0, "Cobalt Engines", now, now, ff_guid()]
                if "syncChangeCounter" in bcols:
                    cols.append("syncChangeCounter")
                    vals.append(1)
                cur = con.execute(f"INSERT INTO moz_bookmarks ({', '.join(cols)}) "
                                  f"VALUES ({', '.join('?' * len(cols))})", vals)
                engine_folder = (cur.lastrowid,)

        def ensure_bookmark(pid, name, url):
            if not engine_folder:
                return
            row = con.execute(
                "SELECT b.id FROM moz_bookmarks b JOIN moz_places p ON p.id = b.fk "
                "WHERE b.parent = ? AND p.url = ?", (engine_folder[0], url)).fetchone()
            if row:
                con.execute("UPDATE moz_bookmarks SET title = ? WHERE id = ?", (name, row[0]))
            else:
                now = ff_now()
                cols = ["type", "fk", "parent", "position", "title", "dateAdded", "lastModified", "guid"]
                vals = [1, pid, engine_folder[0], 0, name, now, now, ff_guid()]
                if "syncChangeCounter" in bcols:
                    cols.append("syncChangeCounter")
                    vals.append(1)
                con.execute(f"INSERT INTO moz_bookmarks ({', '.join(cols)}) "
                            f"VALUES ({', '.join('?' * len(cols))})", vals)

        for e in engines:
            kw = e["keyword"].lower()
            url = e["url"]
            row = con.execute(
                "SELECT p.id, p.url FROM moz_keywords k JOIN moz_places p ON p.id = k.place_id "
                "WHERE k.keyword = ?", (kw,)).fetchone()
            if row and row[1] == url:
                ensure_bookmark(row[0], e["name"], url)
                actions.append(("=", kw, url))
                continue
            place = con.execute("SELECT id FROM moz_places WHERE url = ?", (url,)).fetchone()
            pid = place[0] if place else ff_insert_place(con, pcols, url, "cobalt-managed")
            if row:
                if engine_folder:
                    con.execute("DELETE FROM moz_bookmarks WHERE fk = ? AND parent = ?",
                                (row[0], engine_folder[0]))   # old url's bookmark
                con.execute("UPDATE moz_keywords SET place_id = ? WHERE keyword = ?", (pid, kw))
                actions.append(("~", kw, url))
            else:
                con.execute("INSERT INTO moz_keywords (keyword, place_id) VALUES (?, ?)", (kw, pid))
                actions.append(("+", kw, url))
            ensure_bookmark(pid, e["name"], url)
        if prune:
            keep = {e["keyword"].lower() for e in engines}
            ours = con.execute(
                "SELECT k.keyword, k.place_id FROM moz_keywords k JOIN moz_places p ON p.id = k.place_id "
                "WHERE p.title = 'cobalt-managed'").fetchall()
            for (kw, pid) in ours:
                if kw not in keep:
                    if engine_folder:
                        con.execute("DELETE FROM moz_bookmarks WHERE fk = ? AND parent = ?",
                                    (pid, engine_folder[0]))
                    con.execute("DELETE FROM moz_keywords WHERE keyword = ?", (kw,))
                    actions.append(("-", kw, ""))
        if dry:
            con.rollback()
        else:
            con.commit()
        return actions
    except sqlite3.OperationalError as e:
        sys.exit(f"error: {path} is locked ({e}) — close the browser and retry")
    finally:
        con.close()

def push_bookmarks_ff(profile, tree, dry):
    path = os.path.join(profile, "places.sqlite")
    try:
        con = sqlite3.connect(path)
    except sqlite3.OperationalError as e:
        sys.exit(f"error: cannot open {path} ({e}) — is the browser running? Close it and retry")
    created, renamed, removed = [], [], []
    try:
        bcols = ff_cols(con, "moz_bookmarks")
        pcols = ff_cols(con, "moz_places")
        row = con.execute("SELECT id FROM moz_bookmarks WHERE guid = ?", (FF_BAR_GUID,)).fetchone()
        if row is None:
            sys.exit(f"error: no bookmarks-toolbar root in {path} — open the browser once, then retry")
        bar = row[0]

        def children_of(pid):
            return con.execute(
                "SELECT b.id, b.type, b.title, p.url FROM moz_bookmarks b "
                "LEFT JOIN moz_places p ON p.id = b.fk WHERE b.parent = ? ORDER BY b.position",
                (pid,)).fetchall()

        def node_dict(bid, t, title, url):
            d = {"type": "url" if t == 1 else "folder", "name": title or "",
                 "url": url or "", "children": []}
            for (cid, ct, ctitle, curl) in children_of(bid):
                d["children"].append(node_dict(cid, ct, ctitle, curl))
            return d

        def delete_tree(bid):
            for (cid,) in con.execute("SELECT id FROM moz_bookmarks WHERE parent = ?",
                                      (bid,)).fetchall():
                delete_tree(cid)
            con.execute("DELETE FROM moz_bookmarks WHERE id = ?", (bid,))

        def new_node(kind, parent_id, name, url=None):
            now = ff_now()
            cols = ["type", "parent", "position", "title", "dateAdded", "lastModified", "guid"]
            vals = [1 if kind == "url" else 2, parent_id, 0, name, now, now, ff_guid()]
            if url is not None:
                cols.insert(2, "fk")
                vals.insert(2, ff_insert_place(con, pcols, url, name))
            if "syncChangeCounter" in bcols:
                cols.append("syncChangeCounter")
                vals.append(1)
            cur = con.execute(f"INSERT INTO moz_bookmarks ({', '.join(cols)}) "
                              f"VALUES ({', '.join('?' * len(cols))})", vals)
            return cur.lastrowid

        def sync(parent_id, existing, wanted):
            avail = list(existing)
            result = []
            for w in wanted:
                if w["type"] == "folder":
                    m = next((r for r in avail if r[1] == 2 and (r[2] or "") == w["name"]), None)
                    if m is None:
                        bid = new_node("folder", parent_id, w["name"])
                        created.append({"name": w["name"], "type": "folder"})
                    else:
                        bid = m[0]
                        avail.remove(m)
                    sync(bid, children_of(bid), w["children"])
                else:
                    m = next((r for r in avail if r[1] == 1 and (r[3] or "") == w["url"]), None)
                    if m is None:
                        bid = new_node("url", parent_id, w["name"], w["url"])
                        created.append({"name": w["name"], "type": "url", "url": w["url"]})
                    else:
                        bid = m[0]
                        avail.remove(m)
                        if (m[2] or "") != w["name"]:
                            renamed.append((m[2] or "", w["name"]))
                            sets = "title = ?"
                            if "syncChangeCounter" in bcols:
                                sets += ", syncChangeCounter = syncChangeCounter + 1"
                            con.execute(f"UPDATE moz_bookmarks SET {sets} WHERE id = ?",
                                        (w["name"], bid))
                result.append(bid)
            for i, bid in enumerate(result):
                con.execute("UPDATE moz_bookmarks SET position = ? WHERE id = ?", (i, bid))
            for r in avail:
                removed.append(node_dict(*r))
                delete_tree(r[0])

        sync(bar, children_of(bar), tree)
        if dry:
            con.rollback()
        else:
            con.commit()
        return created, renamed, removed
    except sqlite3.OperationalError as e:
        sys.exit(f"error: {path} is locked ({e}) — close the browser and retry")
    finally:
        con.close()

def pull_bookmarks_ff(profile):
    path = os.path.join(profile, "places.sqlite")
    if not os.path.exists(path):
        return []
    tmp = ff_snapshot(profile)
    try:
        con = sqlite3.connect(tmp)
        try:
            row = con.execute("SELECT id FROM moz_bookmarks WHERE guid = ?",
                              (FF_BAR_GUID,)).fetchone()
            return conv2(con, row[0]) if row else []
        finally:
            con.close()
    finally:
        ff_cleanup(tmp)

def conv2(con, pid):
    out = []
    for (bid, t, title, url) in con.execute(
            "SELECT b.id, b.type, b.title, p.url FROM moz_bookmarks b "
            "LEFT JOIN moz_places p ON p.id = b.fk WHERE b.parent = ? ORDER BY b.position",
            (pid,)).fetchall():
        if t == 1:
            out.append({"type": "url", "name": title or "", "url": url or ""})
        elif t == 2:
            out.append({"type": "folder", "name": title or "", "children": conv2(con, bid)})
    return out

def pull_engines_ff(profile):
    path = os.path.join(profile, "places.sqlite")
    if not os.path.exists(path):
        return []
    tmp = ff_snapshot(profile)
    try:
        con = sqlite3.connect(tmp)
        try:
            rows = con.execute(
                "SELECT k.keyword, p.url FROM moz_keywords k "
                "JOIN moz_places p ON p.id = k.place_id ORDER BY k.keyword").fetchall()
            return [make_engine(r[0], r[0], r[1], 0) for r in rows if r[0] and r[1]]
        finally:
            con.close()
    finally:
        ff_cleanup(tmp)

def backup(path, dry):
    if not dry and os.path.exists(path):
        shutil.copy2(path, path + ".cobalt-bak")

def cmd_list(args):
    roots = browser_roots()
    width = max(map(len, roots))
    found = False
    for name, root in roots.items():
        if not os.path.isdir(root):
            continue
        profiles = find_profiles(root)
        if not profiles:
            continue
        found = True
        print(f"{name.ljust(width)}  {root}")
        for pr in profiles:
            print(f"{' ' * width}    -> {os.path.basename(pr)}  [{profile_kind(pr)}]")
    if not found:
        print("no known browsers found — point me at one with --root /path/to/user-data-dir")

def engine_line(e):

    if e["name"].lower() == e["keyword"].lower():
        return f"{e['keyword']} = {e['url']}"
    return f"{e['name']} | {e['keyword']} | {e['url']}"

def cmd_pull(args):
    root, profiles = resolve_target(args)
    p = profiles[0]
    if profile_kind(p) == "chromium":
        tree = pull_bookmarks(p)
        engines = pull_engines(p)
    else:
        tree = pull_bookmarks_ff(p)
        engines = pull_engines_ff(p)

    kept = 0
    if os.path.exists(args.out or DEFAULT_CONFIG) and not args.out:
        _, cfg_engines = parse_config(args.out or DEFAULT_CONFIG)
        have = {e["keyword"] for e in engines}
        for e in cfg_engines:
            if e["keyword"] not in have:
                engines.append(e)
                kept += 1
        if kept:
            print(f"kept {kept} engine(s) from existing config that the browser doesn't have")

    lines = [
        "# cobalt — generated by `cobalt pull`",
        "#   Name | url                  = bookmark (file order = bar order, strictly)",
        "#   keyword = url               = omnibox engine (jump: `yt` -> youtube.com)",
        "#   Name | keyword | url        = engine with a custom name",
        "#   put %s in the url if you want the query inserted (yt = youtube.com/results?search_query=%s)",
        "#   [Folder]                    = folder; nesting via indentation",
        "",
    ]
    lines += serialize(tree)
    if engines:
        lines += ["", "# ── search engines (omnibox) ──"]
        lines += [engine_line(e) for e in engines]
    out = args.out or DEFAULT_CONFIG
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    print(f"✓ wrote {out} ({os.path.getsize(out)} bytes): "
          f"{len(tree)} top-level bar items, {len(engines)} engines")

def sync_enabled(profile):
    try:
        with open(os.path.join(profile, "Preferences"), encoding="utf-8") as f:
            prefs = json.load(f)
    except (OSError, ValueError):
        return False
    if not prefs.get("sync", {}).get("has_setup_completed"):
        return False
    return prefs.get("sync", {}).get("selected_types", {}).get("bookmarks", True)

def cmd_push(args):
    tree, engines = parse_config(args.config)
    root, profiles = resolve_target(args)
    print(f"config: {args.config}  ({len(engines)} engines)")
    for p in profiles:
        kind = profile_kind(p)
        label = f"{os.path.basename(root)} / {os.path.basename(p)} [{kind}]"
        print(label + ":")
        if kind == "chromium":
            if engines:
                wd = os.path.join(p, "Web Data")
                backup(wd, args.dry)
                actions = push_engines(p, engines, args.prune, args.dry)
                for op, kw, url in actions:
                    print(f"    {op} engine {kw:12} {url}")
                if not actions:
                    print(f"    = engines: no changes")
                if args.dry:
                    print(f"    · {wd} (dry run, not written)")
                else:
                    print(f"    ✓ wrote {wd} ({os.path.getsize(wd)} bytes)")
            bm = os.path.join(p, "Bookmarks")
            backup(bm, args.dry)
            created, renamed, removed = push_bookmarks(p, tree, args.dry)
        else:
            bm = os.path.join(p, "places.sqlite")
            backup(bm, args.dry)
            if engines:
                actions = push_engines_ff(p, engines, args.prune, args.dry)
                for op, kw, url in actions:
                    print(f"    {op} engine {kw:12} {url}")
                if not actions:
                    print(f"    = engines: no changes")
            created, renamed, removed = push_bookmarks_ff(p, tree, args.dry)
        print(f"    bar: {len(created)} added, {len(renamed)} renamed, {sum(count_urls(r) for r in removed)} urls removed")
        for c in created:
            print(f"    + bookmark {c['name']} -> {c.get('url', '')[:60]}")
        for old, new in renamed:
            print(f"    ~ renamed: {old} -> {new}")
        for r in removed:
            n = count_urls(r)
            print(f"    - removed: {r.get('name', '?')}" +
                  (f" ({n} url{'s' if n != 1 else ''})" if r.get("type") == "folder" else
                   f" ({r.get('url', '?')[:60]})"))
        if removed and sync_enabled(p):
            print("    ⚠ Chrome Sync is ON for bookmarks — the server may re-add these "
                  "deleted items on next launch.")
            print("      If they come back: chrome://settings/syncSetup → Manage sync → "
                  "toggle Bookmarks off (or delete them once inside Chrome).")
        if args.dry:
            print(f"    · {bm} (dry run, not written)")
        else:
            print(f"    ✓ wrote {bm} ({os.path.getsize(bm)} bytes)")
    if args.dry:
        print("(dry run — nothing written)")

def hex_to_skcolor(s):
    """'#7C4DFF' / '7C4DFF' / 'c4d' / '#7C4DFF80' -> (SkColor rgba int, '#RRGGBB', alpha)."""
    t = s.strip().lstrip("#")
    if t.lower().startswith("0x"):
        t = t[2:]
    if not re.fullmatch(r"[0-9a-fA-F]{3,8}", t) or len(t) not in (3, 6, 8):
        raise ValueError(f"not a hex color: '{s}'")
    if len(t) == 3:
        t = "".join(c * 2 for c in t)
    v = int(t, 16)
    if len(t) == 6:
        v |= 0xFF000000
    return v, f"#{(v >> 16) & 0xFF:02X}{(v >> 8) & 0xFF:02X}{v & 0xFF:02X}", (v >> 24) & 0xFF

def skcolor_signed(v):
    return v - 0x100000000 if v & 0x80000000 else v

def skcolor_describe(v):
    """human-readable SkColor: hex + alpha note + signed decimal"""
    v &= 0xFFFFFFFF
    a = (v >> 24) & 0xFF
    out = f"#{(v >> 16) & 0xFF:02X}{(v >> 8) & 0xFF:02X}{v & 0xFF:02X}"
    if a != 0xFF:
        out += f" (alpha 0x{a:02X})"
    return out + f" (signed {skcolor_signed(v)})"

def browser_running(root):
    """presence of a singleton file in the user-data dir means the browser is up
    (macOS/Linux). can be left stale after a crash — that's what --force is for."""
    for name in ("SingletonSocket", "SingletonCookie", "SingletonLock"):
        if os.path.exists(os.path.join(root, name)):
            return name
    return None

def cmd_seed(args):
    hex_raw = args.hex_color
    if hex_raw is None:
        # allow `cobalt seed '#7C4DFF'` — browser positional defaults to chrome
        try:
            hex_to_skcolor(args.browser)
        except ValueError:
            if args.browser == "chrome":
                sys.exit("error: missing color argument\n"
                         "       usage: cobalt seed [browser] '#RRGGBB' [--profile <name>] [--root <dir>]\n"
                         "       (quote the # — unquoted, the shell eats it as a comment)")
            sys.exit(f"error: '{args.browser}' is not a hex color\n"
                     "       usage: cobalt seed [browser] '#RRGGBB' [--profile <name>] [--root <dir>]")
        args.browser, hex_raw = "chrome", args.browser

    try:
        rgba, hexnorm, alpha = hex_to_skcolor(hex_raw)
    except ValueError as e:
        sys.exit(f"error: {e}\n"
                 "       examples: '#7C4DFF', '7C4DFF', 'c4d', '#7C4DFF80' (quote the # in shells)")
    signed = skcolor_signed(rgba)

    root, profiles = resolve_target(args)

    lock = browser_running(root)
    if lock:
        msg = (f"error: the browser looks like it's RUNNING ({lock} exists in {root})\n"
               f"       it rewrites Preferences on exit and will clobber the seed.\n"
               f"       quit it fully (cmd-Q, not just the window) and retry.")
        if args.force:
            print("⚠ --force: writing anyway — stale lock after a crash, or your call")
        else:
            sys.exit(msg)

    print(f"seed color {hexnorm} -> SkColor 0x{rgba:08X} (signed {signed})")
    if alpha != 0xFF:
        print(f"  ⚠ alpha 0x{alpha:02X} — chrome's picker always writes FF; non-opaque seeds are untested")

    wrote_any = False
    for p in profiles:
        kind = profile_kind(p)
        label = f"{os.path.basename(root)} / {os.path.basename(p)} [{kind or '?'}]"
        print(label + ":")
        if kind != "chromium":
            print("    ✗ seed only works with chromium-family browsers — "
                  "firefox profiles have no Preferences file. skipped")
            continue
        path = os.path.join(p, "Preferences")
        try:
            with open(path, encoding="utf-8") as f:
                raw = f.read()
            prefs = json.loads(raw)
        except OSError as e:
            sys.exit(f"    error: cannot read {path} ({e})")
        except ValueError as e:
            sys.exit(f"    error: {path} is not valid JSON ({e}) — refusing to touch it")
        if not isinstance(prefs, dict):
            sys.exit(f"    error: {path} is not a JSON object — refusing to touch it")

        theme = prefs.get("browser", {}).get("theme", {})
        if not isinstance(theme, dict):
            theme = prefs.setdefault("browser", {}).setdefault("theme", {})

        # ── report current state, verbosely, before changing anything ──
        if "user_color2" in theme:
            print(f"    current user_color2 : {skcolor_describe(theme['user_color2'])}")
        else:
            print("    current user_color2 : absent (no seed, or the theme extension wiped it)")
        if "user_color" in theme:
            print(f"    main accent user_color: {skcolor_describe(theme['user_color'])}")
        if "saved_local_theme" in theme:
            print("    saved_local_theme   : present — will be deleted (it outranks user_color2)")
        else:
            print("    saved_local_theme   : absent")
        sync_sel = prefs.get("sync", {}).get("selected_types", {})
        if prefs.get("sync", {}).get("has_setup_completed") and sync_sel.get("themes", True):
            print("    ⚠ chrome Sync is ON and includes themes — the account copy may stomp this seed")

        backup(path, args.dry)

        theme["user_color2"] = signed
        theme["user_color"] = signed  # MAIN accent key — the old "inert legacy" claim was wrong (proven 2026-09-09)
        theme.pop("saved_local_theme", None)
        acc = prefs.get("account_values", {}).get("browser", {}).get("theme")
        if isinstance(acc, dict):
            acc["user_color"] = signed
            print("    mirrored into account_values.browser.theme.user_color")
        else:
            print("    account_values.browser.theme: not present — nothing to mirror")

        if args.dry:
            print(f"    · would set user_color + user_color2 = {hexnorm} (signed {signed}) — dry run, not written")
            continue

        indent = 2 if "\n" in raw.rstrip("\n") else None  # match the file's existing style
        tmp = path + ".cobalt-tmp"
        try:
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(prefs, f, indent=indent, ensure_ascii=False,
                          separators=None if indent else (",", ":"))
            os.replace(tmp, path)
        except OSError as e:
            if os.path.exists(tmp):
                os.unlink(tmp)
            sys.exit(f"    error: cannot write {path} ({e})")
        print(f"    ✓ user_color + user_color2 -> {hexnorm} (signed {signed}), saved_local_theme cleared")
        print(f"    ✓ wrote {path} ({os.path.getsize(path)} bytes), backup at {path}.cobalt-bak")
        wrote_any = True

    if args.dry:
        print("(dry run — nothing written)")
    elif wrote_any:
        record_state("seed", {"hex": hexnorm, "browser": args.browser,
                              "profile": args.profile, "root": args.root,
                              "all": bool(getattr(args, "all_profiles", False))})
        print(f"remembered: `cobalt reload` will re-apply this seed ({hexnorm})")
    elif wrote_any:
        print("done. relaunch the browser — it re-reads Preferences (and theme manifests) at startup.")
        print("note: loading/unloading the theme extension wipes user_color2 — re-run `seed` after.")

def cmd_avatar(args):
    """replace every avatar PNG in a chromium user-data dir's Avatars/ folder."""
    if sys.platform != "darwin":
        print("⚠ cobalt avatar is only verified on macOS + google chrome — "
              "continuing on this platform is untested")
    img = os.path.abspath(os.path.expanduser(args.image))
    if not os.path.isfile(img):
        sys.exit(f"error: {img} does not exist")
    with open(img, "rb") as f:
        head = f.read(24)
    if head[:8] != b"\x89PNG\r\n\x1a\n":
        sys.exit(f"error: {os.path.basename(img)} is not a PNG\n"
                 "       avatar images must be exactly 192x192 PNG — no resizing is done here")
    w, h = struct.unpack(">II", head[16:24])
    if (w, h) != (192, 192):
        sys.exit(f"error: {os.path.basename(img)} is {w}x{h}, must be exactly 192x192\n"
                 "       resize it first:\n"
                 "         macOS: sips -z 192 192 in.png --out out.png\n"
                 "         imagemagick: magick in.png -resize 192x192! out.png")

    root = (os.path.abspath(os.path.expanduser(args.root)) if args.root
            else browser_roots().get(args.browser))
    if not root or not os.path.isdir(root):
        sys.exit(f"error: browser '{args.browser}' not found. Try `ls`, or pass --root.")
    av = os.path.join(root, "Avatars")
    if not os.path.isdir(av):
        sys.exit(f"error: no Avatars/ folder under {root} — open the browser once, then retry")
    targets = [f for f in sorted(os.listdir(av)) if f.lower().endswith(".png")]
    if not targets:
        sys.exit(f"error: no PNGs in {av} — nothing to replace")
    lock = browser_running(root)
    if lock and not args.force:
        sys.exit(f"error: the browser looks like it's RUNNING ({lock} exists in {root})\n"
                 f"       it may re-download/rewrite the avatar cache on exit.\n"
                 f"       quit it fully (cmd-Q) and retry, or pass --force")

    print(f"image: {img} (192x192 PNG, {os.path.getsize(img)} bytes)")
    for p in find_profiles(root):
        try:
            with open(os.path.join(p, "Preferences"), encoding="utf-8") as f:
                prof = json.load(f).get("profile", {})
            if prof.get("using_gaia_avatar"):
                print(f"  ⚠ profile {os.path.basename(p)} uses a signed-in account picture "
                      f"— it will not reflect this change")
        except (OSError, ValueError):
            pass

    replaced = 0
    for f in targets:
        dst = os.path.join(av, f)
        if os.path.abspath(dst) == img:
            continue
        if args.dry:
            print(f"  · would replace: {f} ({os.path.getsize(dst)} bytes)")
            continue
        backup(dst, args.dry)
        shutil.copy2(img, dst)
        replaced += 1
        print(f"  ✓ replaced: {f} (backup at {f}.cobalt-bak)")
    if args.dry:
        print(f"(dry run — {len(targets)} avatar(s) would be replaced)")
    else:
        record_state("avatar", {"image": img, "browser": args.browser, "root": args.root})
        print(f"done. {replaced} avatar(s) replaced — relaunch the browser to see it.\n"
              f"remembered: `cobalt reload` will re-apply this avatar ({os.path.basename(img)})\n"
              f"note: a chrome update rewrites the bundle AND may re-download the avatar "
              f"cache; re-run if the old face ever comes back.")

def cmd_reload(args):
    state = load_state()
    jobs = []
    if "seed" in state:
        s = state["seed"]
        jobs.append(("seed", argparse.Namespace(
            browser=s.get("browser") or "chrome", hex_color=s.get("hex"),
            profile=s.get("profile"), root=s.get("root"),
            all_profiles=bool(s.get("all")), force=args.force, dry=args.dry)))
    if "avatar" in state:
        a = state["avatar"]
        jobs.append(("avatar", argparse.Namespace(
            image=a.get("image"), browser=a.get("browser") or "chrome",
            root=a.get("root"), force=args.force, dry=args.dry)))
    if not jobs:
        sys.exit("nothing to reload — run `cobalt seed` and/or `cobalt avatar` once first; "
                 "cobalt remembers the last color and image and re-applies them here")

    print(f"re-applying last-seen settings (recorded {state.get('updated', '?')}):")
    for name, ns in jobs:
        print(f"── {name} ──")
        try:
            (cmd_seed if name == "seed" else cmd_avatar)(ns)
        except SystemExit as e:
            # a failed half (browser missing, image gone) shouldn't stop the other one
            print(f"  (skipped: {e})")

def cmd_init(args):
    if os.path.exists(DEFAULT_CONFIG) and not args.force:
        sys.exit(f"error: {DEFAULT_CONFIG} already exists (use --force to overwrite)")
    os.makedirs(os.path.dirname(DEFAULT_CONFIG), exist_ok=True)
    example = os.path.join(os.path.dirname(os.path.abspath(__file__)), "cobalt.conf.example")
    if os.path.exists(example):
        shutil.copy(example, DEFAULT_CONFIG)
    else:
        open(DEFAULT_CONFIG, "w").write(
            "GitHub | https://github.com\n[Search]\n  GitHub | gh | https://github.com/search?q=%s\n")
    print(f"wrote {DEFAULT_CONFIG} — edit it, then `cobalt push` with the browser closed")

def main():
    ap = argparse.ArgumentParser(
        prog="cobalt",
        description="bookmarks bar & omnibox keyword engines from one config file")
    ap.add_argument("--config", default=DEFAULT_CONFIG, help=f"(default: {DEFAULT_CONFIG})")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("ls", aliases=["list"], help="list detected browsers/profiles")

    p_push = sub.add_parser("push", help="apply config -> browser (bar made to match exactly)")
    p_push.add_argument("browser", nargs="?", default="chrome")
    p_push.add_argument("--root", help="user-data dir of any Chromium fork")
    p_push.add_argument("--profile", help="target one profile (e.g. 'Profile 7', 'Default')")
    p_push.add_argument("--prune", action="store_true",
                        help="delete engine rows we manage that are no longer in config")
    p_push.add_argument("--all", dest="all_profiles", action="store_true",
                        help="apply to every profile (default asks you to pick)")
    p_push.add_argument("--dry", action="store_true")

    p_pull = sub.add_parser("pull", help="browser -> config (exact nesting/order)")
    p_pull.add_argument("browser", nargs="?", default="chrome")
    p_pull.add_argument("--root", help="user-data dir of any Chromium fork")
    p_pull.add_argument("--profile", help="read one profile")
    p_pull.add_argument("--all", dest="all_profiles", action="store_true",
                        help="merge from every profile (default asks you to pick)")
    p_pull.add_argument("-o", "--out", help="write here instead of the default config path")

    p_seed = sub.add_parser("seed",
                            help="set the theme seed color (user_color2 + legacy user_color) in a Chromium profile")
    p_seed.add_argument("browser", nargs="?", default="chrome",
                        help="target browser (default: chrome)")
    p_seed.add_argument("hex_color", nargs="?",
                        help="seed color: '#7C4DFF', '7C4DFF', 'c4d' — QUOTE the # in shells")
    p_seed.add_argument("--root", help="user-data dir of any Chromium fork")
    p_seed.add_argument("--profile", help="target one profile (e.g. 'Default', 'Profile 7')")
    p_seed.add_argument("--all", dest="all_profiles", action="store_true",
                        help="apply to every profile (default asks you to pick)")
    p_seed.add_argument("--force", action="store_true",
                        help="write even if the browser appears to be running")
    p_seed.add_argument("--dry", action="store_true")

    p_avatar = sub.add_parser("avatar",
                              help="replace every avatar PNG in a chromium Avatars/ folder "
                                   "with one 192x192 PNG (toolbar profile icon). "
                                   "macOS + google chrome only (verified combo)")
    p_avatar.add_argument("image", help="path to a 192x192 PNG — exact, no resizing is done")
    p_avatar.add_argument("browser", nargs="?", default="chrome",
                          help="target browser (default: chrome; only chrome verified)")
    p_avatar.add_argument("--root", help="user-data dir of any Chromium fork (macOS paths only)")
    p_avatar.add_argument("--force", action="store_true",
                          help="write even if the browser appears to be running")
    p_avatar.add_argument("--dry", action="store_true")

    p_reload = sub.add_parser("reload",
                              help="re-apply the last `seed` color and last `avatar` image "
                                   "(e.g. after a chrome update resets them)")
    p_reload.add_argument("--dry", action="store_true")
    p_reload.add_argument("--force", action="store_true",
                          help="write even if the browser appears to be running")

    p_init = sub.add_parser("init", help="create a starter config")
    p_init.add_argument("--force", action="store_true")

    args = ap.parse_args()
    {"ls": cmd_list, "list": cmd_list, "push": cmd_push, "pull": cmd_pull,
     "seed": cmd_seed, "avatar": cmd_avatar, "reload": cmd_reload,
     "init": cmd_init}[args.cmd](args)

if __name__ == "__main__":
